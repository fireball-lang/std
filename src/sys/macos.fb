#[extern]
pub func listen(fd: i32, backlog: i32) i32;

#[extern]
pub func accept(fd: i32, addr: mut *SocketAddress, len: mut *u32) i32;

#[extern]
pub func send(fd: i32, buf: *void, len: u64, flags: i32) i64;

#[extern]
pub func recv(fd: i32, buf: mut *void, len: u64, flags: i32) i64;

// LibC

#[extern]
pub func dlopen(name: *u8, flags: LibFlags) *void;

#[extern]
pub func dlsym(handle: *void, name: *u8) *void;

#[extern]
pub func dlclose(handle: *void) i32;

#[extern]
pub func getaddrinfo(name: *u8, service: *u8, hints: *DnsEntry, result: mut **DnsEntry) i32;

#[extern]
pub func freeaddrinfo(result: *DnsEntry);

// Secure channel

#[extern]
pub func SSLCreateContext(alloc: *void, protocolSide: i32, connectionType: i32) *SslCtx;

#[extern]
pub func SSLSetIOFuncs(ctx: *SslCtx, read_func: func(*void, mut* void, mut* u64) i32, write_func: func(*void, *void, mut* u64) i32) i32;

#[extern]
pub func SSLSetConnection(ctx: *SslCtx, connection: *void) i32;

#[extern]
pub func SSLSetPeerDomainName(ctx: *SslCtx, peerName: *void, peerNameLen: u64) i32;

#[extern]
pub func SSLHandshake(ctx: *SslCtx) i32;

#[extern]
pub func SSLRead(ctx: *SslCtx, data: mut* void, dataLen: u64, processed: mut* u64) i32;

#[extern]
pub func SSLWrite(ctx: *SslCtx, data: *void, dataLen: u64, processed: mut* u64) i32;

#[extern]
pub func SSLClose(ctx: *SslCtx) i32;

#[extern]
pub func CFRelease(cf: *void);

// Utils

pub func at_fdcwd() i32 {
    return -2;
}
