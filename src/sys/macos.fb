#[cfg(target_os = "macos")]

mod std::sys;

// Enums

pub enum FileFlags : i32 {
    ReadOnly    = 0,
    WriteOnly   = 1,
    Create      = 512,
    Truncate    = 1024,
    Directory   = 1048576,
    CloseOnExec = 16777216,
}

impl FileFlags : BitNot {
    type Result = FileFlags;

    pub func bit_not(self) Result {
        return ~(*self as i32) as Self;
    }
}

impl FileFlags : BitOr[FileFlags] {
    type Result = FileFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

pub enum LibFlags : i32 {
    Lazy     = 0x00001,
    Now      = 0x00002,
    NoLoad   = 0x00010,

    Global   = 0x00008,
    Local    = 0x0004,

    NoDelete = 0x00080,
}

impl LibFlags : BitNot {
    type Result = LibFlags;

    pub func bit_not(self) Result {
        return ~(*self as i32) as Self;
    }
}

impl LibFlags : BitOr[LibFlags] {
    type Result = LibFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

pub enum IoctlOp : u64 {
    TIOCGWINSZ = 0x40087468,
    TCGETS = 0x40487413,
    TCSETS = 0x80487414,
}

pub enum PollEvent : i16 {
    IN    = 0x0001,
    PRI   = 0x0002,
    OUT   = 0x0004,
    ERR   = 0x0008,
    HUP   = 0x0010,
    NVAL  = 0x0020,
}

impl PollEvent : BitNot {
    type Result = PollEvent;

    pub func bit_not(self) Result {
        return ~(*self as i16) as Self;
    }
}

impl PollEvent : BitOr[PollEvent] {
    type Result = PollEvent;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i16 | rhs as i16) as Self;
    }
}

impl PollEvent : BitAnd[PollEvent] {
    type Result = PollEvent;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as i16 & rhs as i16) as Self;
    }
}

pub enum InputFlags : u64 {
    IGNBRK  = 0x00000001,
    BRKINT  = 0x00000002,
    IGNPAR  = 0x00000004,
    PARMRK  = 0x00000008,
    INPCK   = 0x00000010,
    ISTRIP  = 0x00000020,
    INLCR   = 0x00000040,
    IGNCR   = 0x00000080,
    ICRNL   = 0x00000100,
    IXON    = 0x00000200,
    IXOFF   = 0x00000400,
    IXANY   = 0x00000800,
    IMAXBEL = 0x00002000,
    IUTF8   = 0x00004000,
}

impl InputFlags : BitNot {
    type Result = InputFlags;

    pub func bit_not(self) Result {
        return ~(*self as u64) as Self;
    }
}

impl InputFlags : BitOr[InputFlags] {
    type Result = InputFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u64 | rhs as u64) as Self;
    }
}

impl InputFlags : BitAnd[InputFlags] {
    type Result = InputFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u64 & rhs as u64) as Self;
    }
}

pub enum OutputFlags : u64 {
    OPOST  = 0x00000001,
    ONLCR  = 0x00000002,
    OXTABS = 0x00000004,
    ONOEOT = 0x00000008,
    OCRNL  = 0x00000010,
    ONOCR  = 0x00000020,
    ONLRET = 0x00000040,
}

impl OutputFlags : BitNot {
    type Result = OutputFlags;

    pub func bit_not(self) Result {
        return ~(*self as u64) as Self;
    }
}

impl OutputFlags : BitOr[OutputFlags] {
    type Result = OutputFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u64 | rhs as u64) as Self;
    }
}

impl OutputFlags : BitAnd[OutputFlags] {
    type Result = OutputFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u64 & rhs as u64) as Self;
    }
}

pub enum ControlFlags : u64 {
    CIGNORE    = 0x00000001,
    CS5        = 0x00000000,
    CS6        = 0x00000100,
    CS7        = 0x00000200,
    CSIZE      = 0x00000300,
    CSTOPB     = 0x00000400,
    CREAD      = 0x00000800,
    PARENB     = 0x00001000,
    PARODD     = 0x00002000,
    HUPCL      = 0x00004000,
    CLOCAL     = 0x00008000,
    CCTS_OFLOW = 0x00010000,
    CRTS_IFLOW = 0x00020000,
    CRTSCTS    = 0x00030000,
    CDTR_IFLOW = 0x00040000,
    CDSR_OFLOW = 0x00080000,
    CCAR_OFLOW = 0x00100000,
}

impl ControlFlags : BitNot {
    type Result = ControlFlags;

    pub func bit_not(self) Result {
        return ~(*self as u64) as Self;
    }
}

impl ControlFlags : BitOr[ControlFlags] {
    type Result = ControlFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u64 | rhs as u64) as Self;
    }
}

impl ControlFlags : BitAnd[ControlFlags] {
    type Result = ControlFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u64 & rhs as u64) as Self;
    }
}

pub enum LocalFlags : u64 {
    ECHOKE    = 0x00000001,
    ECHOE     = 0x00000002,
    ECHOK     = 0x00000004,
    ECHO      = 0x00000008,
    ECHONL    = 0x00000010,
    ECHOPRT   = 0x00000020,
    ECHOCTL   = 0x00000040,
    ISIG      = 0x00000080,
    ICANON    = 0x00000100,
    ALTWERASE = 0x00000200,
    IEXTEN    = 0x00000400,
    EXTPROC   = 0x00000800,
    TOSTOP    = 0x00400000,
    FLUSHO    = 0x00800000,
    PENDIN    = 0x20000000,
    NOFLSH    = 0x80000000,
}

impl LocalFlags : BitNot {
    type Result = LocalFlags;

    pub func bit_not(self) Result {
        return ~(*self as u64) as Self;
    }
}

impl LocalFlags : BitOr[LocalFlags] {
    type Result = LocalFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u64 | rhs as u64) as Self;
    }
}

impl LocalFlags : BitAnd[LocalFlags] {
    type Result = LocalFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u64 & rhs as u64) as Self;
    }
}

pub enum ControlChar : u32 {
    VEOF     = 0,
    VEOL     = 1,
    VEOL2    = 2,
    VERASE   = 3,
    VWERASE  = 4,
    VKILL    = 5,
    VREPRINT = 6,
    VINTR    = 8,
    VQUIT    = 9,
    VSUSP    = 10,
    VDSUSP   = 11,
    VSTART   = 12,
    VSTOP    = 13,
    VLNEXT   = 14,
    VDISCARD = 15,
    VMIN     = 16,
    VTIME    = 17,
}

pub enum Domain : i32 {
    IP4 = 2,
    IP6 = 10,
}

pub enum Type : i32 {
    TCP = 1,
    UDP = 2,
}

pub enum Protocol : i32 {
    IP = 0,
}

// Structs

#[repr(C)]
pub struct Dirent64 {
    pub ino: u64,
    pub off: i64,
    pub reclen: u16,
    pub namelen: u16,
    pub type_: u8,
}

impl Dirent64 {
    pub func name(self) StringView {
        return StringView {
            ptr: &(self as *u8)[offsetof(Dirent64, type_) + 1],
            size: self.namelen,
        };
    }
}

#[repr(C)]
pub struct Timespec {
    pub sec: i64,
    pub nsec: i64,
}

#[repr(C)]
pub struct Stat {
    pub dev: i32,
    pub mode: u16,
    pub nlink: u16,
    pub ino: u64,
    pub uid: u32,
    pub gid: u32,
    pub rdev: i32,

    pub atim: Timespec,
    pub mtim: Timespec,
    pub ctim: Timespec,
    pub birthtim: Timespec,

    pub size: u64,
    pub blocks: u64,
    pub blksize: u32,
    pub flags: u32,
    pub gen: u32,

    pub lspare: i32,
    pub qspare: [2]i64,
}

#[repr(C)]
pub struct MachTimebaseInfo {
    pub numer: u32,
    pub denom: u32,
}

#[repr(C)]
pub struct PollFd {
    pub fd: i32,
    pub req_events: PollEvent,
    pub ret_events: PollEvent,
}

#[repr(C)]
pub struct Termios {
    pub input_flags: InputFlags,
    pub output_flags: OutputFlags,
    pub control_flags: ControlFlags,
    pub local_flags: LocalFlags,
    pub control_chars: [20]u8,
    pub input_speed: u64,
    pub output_speed: u64,
}

impl Termios {
    pub func control_char(mut self, char: ControlChar) mut &u8 {
        return &self.control_chars[char as u32];
    }
}

#[repr(C)]
pub struct WinSize {
    pub row: u16,
    pub col: u16,
    pub xpixel: u16,
    pub ypixel: u16,
}

#[repr(C)]
pub struct SocketAddress {
    pub domain: u16,
    port: u16,
    pub ip: [4]u8,

    _pad: [8]u8,
}

impl SocketAddress {
    pub func new(domain: Domain, ip: [4]u8, port: u16) Self {
        return Self {
            domain: domain as u16,
            port: ((port >> 8u) & 0xFF) | ((port & 0xFF) << 8u),
            ip: ip,
        };
    }

    pub func port(self) u16 {
        return ((self.port >> 8u) & 0xFF) | ((self.port & 0xFF) << 8u);
    }
}

#[repr(C)]
pub struct DnsEntry {
    pub flags: i32,
    pub family: Domain,
    pub socktype: Type,
    pub protocol: i32,
    pub addrlen: u32,
    pub addr: *SocketAddress,
    pub canonname: *u8,
    pub next: *DnsEntry,
}

#[repr(C)]
pub struct SslCtx {}

// Posix functions

#[extern]
pub func getcwd(buffer: mut *u8, size: u64) *u8;

#[extern]
pub func mkdir(path: *u8, mode: u32) i32;

#[extern]
pub func rmdir(path: *u8) i32;

#[extern]
pub func openat(fd: i32, path: *u8, flags: FileFlags, mode: i32) i32;

#[extern]
pub func close(fd: i32) i32;

#[extern]
pub func getdirentries(fd: i32, buffer: mut *void, size: i32, base: mut *i64) i32;

#[extern]
pub func lseek(fd: i32, offset: i64, whence: i32) i64;

#[extern]
pub func read(fd: i32, buffer: mut *void, size: u64) i64;

#[extern]
pub func write(fd: i32, data: *void, size: u64) i64;

#[extern]
pub func fstatat(fd: i32, path: *u8, stat: mut *Stat, flags: i32) i32;

#[extern]
pub func open(path: *u8, flags: FileFlags) i32;

#[extern]
pub func fcntl(fd: i32, cmd: i32, arg: i32) i32;

#[extern]
pub func pipe(fds: mut *i32) i32;

#[extern]
pub func dup2(oldfd: i32, newfd: i32) i32;

#[extern]
pub func fork() i32;

#[extern]
pub func chdir(path: *u8) i32;

#[extern]
pub func execve(file: *u8, argv: **u8, envp: **u8) i32;

#[extern]
pub func waitpid(pid: i32, status: mut *i32, options: i32) i32;

#[extern]
pub func exit(code: i32);

#[extern]
pub func mach_continuous_time() u64;

#[extern]
pub func mach_timebase_info(info: mut *MachTimebaseInfo) i32;

#[extern]
pub func ioctl(fd: i32, op: IoctlOp, argp: mut *void) i32;

#[extern]
pub func poll(fds: *PollFd, count: u32, timeout: i32) i32;

#[extern]
pub func socket(domain: Domain, type_: Type, protocol: Protocol) i32;

#[extern]
pub func bind(fd: i32, addr: *SocketAddress, len: u32) i32;

#[extern]
