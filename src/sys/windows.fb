#[cfg(target_os = "windows")]

mod std::sys;

// Enums

pub enum Access : u32 {
    All = 0x10000000,
    Execute = 0x20000000,
    Write = 0x40000000,
    Read = 0x80000000,
}

impl Access : BitOr[Access] {
    type Result = Access;

    pub func bit_or(self, rhs: Self) Self {
        return ((*self as u32) | (rhs as u32)) as Self;
    }
}

pub enum Share : u32 {
    Exclusive = 0,
    Read = 1,
    Write = 2,
    Delete = 4,
}

impl Share : BitOr[Share] {
    type Result = Share;

    pub func bit_or(self, rhs: Self) Self {
        return ((*self as u32) | (rhs as u32)) as Self;
    }
}

pub enum Disposition : u32 {
    CreateNew = 1,
    CreateAlways = 2,
    OpenExisting = 3,
    OpenAlways = 4,
    TruncateExisting = 5,
}

pub enum Flags : u32 {
    // Attributes
    ReadOnly = 1,
    Hidden = 2,
    System = 4,
    Archive = 32,
    Normal = 128,
    Temporary = 256,
    Offline = 4096,
    Encrypted = 16384,

    // Flags
    BackupSemantics = 0x02000000,
    DeleteOnClose = 0x04000000,
    NoBuffering = 0x20000000,
    OpenNoRecall = 0x00100000,
    OpenReparsePoint = 0x00200000,
    Overlapped = 0x40000000,
    PosixSemantics = 0x01000000,
    RandomAccess = 0x10000000,
    SessionAware = 0x00800000,
    SequentialScan = 0x08000000,
    WriteThrough = 0x80000000,
}

impl Flags : BitOr[Flags] {
    type Result = Flags;

    pub func bit_or(self, rhs: Self) Self {
        return ((*self as u32) | (rhs as u32)) as Self;
    }
}

pub enum HandleFlags : u32 {
    Inherit = 1,
    ProtectFromClose = 2,
}

impl HandleFlags : BitOr[HandleFlags] {
    type Result = HandleFlags;

    pub func bit_or(self, rhs: Self) Self {
        return ((*self as u32) | (rhs as u32)) as Self;
    }
}

pub enum InputConsoleMode : u32 {
    EnableProcessedInput = 0x0001,
    EnableLineInput = 0x0002,
    EnableEchoInput = 0x0004,
    EnableWindowInput = 0x0008,
    EnableMouseInput = 0x0010,
    EnableInsertMode = 0x0020,
    EnableQuickEditMode = 0x0040,
    EnableVirtualTerminalInput = 0x0200,
}

impl InputConsoleMode : BitOr[InputConsoleMode] {
    type Result = InputConsoleMode;

    pub func bit_or(self, rhs: Self) Self {
        return ((*self as u32) | (rhs as u32)) as Self;
    }
}

impl InputConsoleMode : BitAnd[InputConsoleMode] {
    type Result = InputConsoleMode;

    pub func bit_and(self, rhs: Self) Self {
        return ((*self as u32) & (rhs as u32)) as Self;
    }
}

pub enum ScreenConsoleMode : u32 {
    EnableProcessedOutput = 0x0001,
    EnableWrapAtEolOutput = 0x0002,
    EnableVirtualTerminalProcessing = 0x0004,
    DisableNewLineAutoReturn = 0x0008,
    EnableLvbGridWorldwide = 0x0010,
}

impl ScreenConsoleMode : BitOr[ScreenConsoleMode] {
    type Result = ScreenConsoleMode;

    pub func bit_or(self, rhs: Self) Self {
        return ((*self as u32) | (rhs as u32)) as Self;
    }
}

impl ScreenConsoleMode : BitAnd[ScreenConsoleMode] {
    type Result = ScreenConsoleMode;

    pub func bit_and(self, rhs: Self) Self {
        return ((*self as u32) & (rhs as u32)) as Self;
    }
}

pub enum Domain : i32 {
    IP4 = 2,
    IP6 = 23,
}

pub enum Type : i32 {
    TCP = 1,
    UDP = 2,
}

pub enum Protocol : i32 {
    IP = 6,
    UDP = 17,
}

// Structs

#[repr(C)]
pub struct FileTime {
    pub low: u32,
    pub high: u32,
}

#[repr(C)]
pub struct FileAttributeData {
    pub file_attributes: u32,
    pub creation_time: FileTime,
    pub last_access_time: FileTime,
    pub last_write_time: FileTime,
    pub file_size_high: u32,
    pub file_size_low: u32,
}

#[repr(C)]
pub struct FindData {
    pub file_data: FileAttributeData,
    pub reserved0: u32,
    pub reserved1: u32,
    pub file_name: [260]u8,
    pub alternate_file_name: [14]u8,

    /// Obsolete
    file_type: u32,
    /// Obsolete
    creator_type: u32,
    /// Obsolete
    finder_flags: u16,
}

#[repr(C)]
pub struct SecurityAttributes {
    pub length: u32,
    pub security_descriptor: *void,
    pub inherit_handle: i32,
}

#[repr(C)]
pub struct StartupInfo {
    pub cb: u32,
    pub reserved: *u8,
    pub desktop: *u8,
    pub title: *u8,
    pub x: u32,
    pub y: u32,
    pub x_size: u32,
    pub y_size: u32,
    pub x_count_chars: u32,
    pub y_count_chars: u32,
    pub fill_attribute: u32,
    pub flags: u32,
    pub show_window: u16,
    pub reserved2: u16,
    pub reserved3: *void,
    pub std_input: Handle,
    pub std_output: Handle,
    pub std_error: Handle,
}

#[repr(C)]
pub struct ProcessInformation {
    pub process: Handle,
    pub thread: Handle,
    pub process_id: u32,
    pub thread_id: u32,
}

#[repr(C)]
pub struct WsaData {
    pub version: u16,
    pub high_version: u16,
    pub max_sockets: u16,
    pub max_udp_dg: u16,
    pub vendor_info: *u8,
    pub description: [257]u8,
    pub system_status: [129]u8,
}

#[repr(C)]
pub struct SocketAddress {
    pub domain: u16,
    port: u16,
    pub ip: [4]u8,

    _pad: [8]u8,
}

impl SocketAddress {
    pub func new(domain: Domain, ip: [4]u8, port: u16) Self {
        return Self {
            domain: domain as u16,
            port: ((port >> 8u) & 0xFF) | ((port & 0xFF) << 8u),
            ip: ip,
        };
    }

    pub func port(self) u16 {
        return ((self.port >> 8u) & 0xFF) | ((self.port & 0xFF) << 8u);
    }
}

#[repr(C)]
pub struct DnsEntry {
    pub flags: i32,
    pub family: Domain,
    pub socktype: Type,
    pub protocol: i32,
    pub addrlen: u64,
    pub canonname: *u8,
    pub addr: *SocketAddress,
    pub next: *DnsEntry,
}

#[repr(C)]
pub struct SecHandle {
    pub dwLower: u64,
    pub dwUpper: u64,
}

#[repr(C)]
pub struct SecBuffer {
    pub cbBuffer: u32,
    pub BufferType: u32,
    pub pvBuffer: *void,
}

#[repr(C)]
pub struct SecBufferDesc {
    pub ulVersion: u32,
    pub cBuffers: u32,
    pub pBuffers: *SecBuffer,
}

#[repr(C)]
pub struct SecPkgContext_StreamSizes {
    pub cbHeader: u32,
    pub cbTrailer: u32,
    pub cbMaximumMessage: u32,
    pub cBuffers: u32,
    pub cbBlockSize: u32,
}

#[repr(C)]
pub struct Handle {
    pub raw: *void,
}

impl Handle {
    pub func invalid() Self {
        return Self { raw: (0xFFFFFFFFFFFFFFFF as u64) as *void };
    }

    pub func valid(self) bool {
        return self.raw as u64 != 0xFFFFFFFFFFFFFFFF;
    }
}

// Functions

#[extern]
pub func CreateDirectoryA(path: *u8, security: *SecurityAttributes) i32;

#[extern]
pub func RemoveDirectoryA(path: *u8) i32;

#[extern]
pub func FindFirstFileA(file_name: *u8, data: mut *FindData) Handle;

#[extern]
pub func FindNextFileA(find_file: Handle, data: mut *FindData) i32;

#[extern, link_name("FindClose")]
pub func FindClose_(find_file: Handle) i32;

pub func FindClose(handle: mut &Handle) i32 {
    if (!handle.valid()) return 1;

    var result = FindClose_(*handle);
    *handle = Handle::invalid();

    return result;
}

#[extern]
pub func GetCurrentDirectoryA(length: u32, buffer: mut *u8) u32;

#[extern]
pub func CreateFileA(name: *u8, access: Access, share: Share, security: *SecurityAttributes, disposition: Disposition, flags: Flags, template: *void) Handle;

#[extern]
pub func ReadFile(handle: Handle, buffer: mut* void, bytes_to_read: u32, bytes_read: mut* u32, overlapped: *void) i32;

#[extern]
pub func WriteFile(handle: Handle, data: *void, bytes_to_write: u32, bytes_written: mut* u32, overlapped: *void) i32;

#[extern]
pub func SetFilePointerEx(handle: Handle, distance: i64, new_position: mut* i64, method: u32) i32;

#[extern, link_name("CloseHandle")]
func CloseHandle_(handle: Handle) i32;

pub func CloseHandle(handle: mut &Handle) i32 {
    if (!handle.valid()) return 1;

    var result = CloseHandle_(*handle);
    *handle = Handle::invalid();

    return result;
}

#[extern]
pub func GetFileAttributesExA(file_name: *u8, info_level: i32, file_information: mut *void) i32;

#[extern]
pub func GetFileInformationByHandleEx(handle: Handle, file_information_class: u32, file_information: mut *void, buffer_size: u32) i32;

#[extern]
pub func GetStdHandle(std_handle: u32) Handle;

#[extern]
pub func LoadLibraryA(name: *u8) *void;

#[extern]
pub func GetProcAddress(module: *void, name: *u8) *void;

#[extern]
pub func FreeLibrary(module: *void) i32;

#[extern]
pub func CreatePipe(read_pipe: mut *Handle, write_pipe: mut *Handle, security: *SecurityAttributes, size: u32) i32;

#[extern]
pub func SetHandleInformation(handle: Handle, mask: HandleFlags, flags: HandleFlags) i32;

#[extern]
pub func CreateProcessA(
    application_name: *u8,
    command_line: *u8,
    process_attributes: *SecurityAttributes,
    thread_attributes: *SecurityAttributes,
    inherit_handles: i32,
    creation_flags: u32,
    envrionment: *u8,
    current_directory: *u8,
    startup_info: *StartupInfo,
    process_informaton: mut *ProcessInformation,
) i32;

#[extern]
pub func WaitForSingleObject(handle: Handle, ms: u32) u32;

#[extern]
pub func GetExitCodeProcess(process: Handle, exit_code: mut *u32) i32;

#[extern]
pub func ExitProcess(code: u32);

#[extern]
pub func QueryPerformanceCounter(performance_count: mut *u64) i32;

#[extern]
pub func QueryPerformanceFrequency(frequency: mut *u64) i32;

#[extern]
pub func GetInputConsoleMode(handle: Handle, mode: mut *InputConsoleMode) i32;
#[extern]
pub func GetScreenConsoleMode(handle: Handle, mode: mut *ScreenConsoleMode) i32;

#[extern]
pub func SetInputConsoleMode(handle: Handle, mode: InputConsoleMode) i32;
#[extern]
pub func SetScreenConsoleMode(handle: Handle, mode: ScreenConsoleMode) i32;

#[extern, link_name("WSAStartup")]
pub func wsa_startup(version: u16, data: mut* WsaData) i32;

#[extern]
pub func socket(domain: Domain, type_: Type, protocol: Protocol) u64;

#[extern]
pub func bind(fd: u64, addr: *SocketAddress, len: i32) i32;

#[extern]
pub func connect(fd: u64, addr: *SocketAddress, len: i32) i32;

#[extern]
pub func listen(fd: u64, backlog: i32) i32;

#[extern]
pub func accept(fd: u64, addr: mut* SocketAddress, len: mut* i32) u64;

#[extern]
pub func send(fd: u64, buf: *void, len: i32, flags: i32) i32;

#[extern]
pub func recv(fd: u64, buf: mut* void, len: i32, flags: i32) i32;

#[extern]
pub func closesocket(fd: u64) i32;

#[extern]
pub func getaddrinfo(name: *u8, service: *u8, hints: *DnsEntry, result: mut** DnsEntry) i32;

#[extern]
pub func freeaddrinfo(result: *DnsEntry);

#[extern]
pub func AcquireCredentialsHandleA(pszPrincipal: *void, pszPackage: *void, fCredentialUse: u32, pvLogonID: *void, pAuthData: *void, pGetKeyFn: *void, pvGetKeyArgument: *void, phCredential: *SecHandle, ptsExpiry: *void) i32;

#[extern]
pub func InitializeSecurityContextA(phCredential: *SecHandle, phContext: *SecHandle, pszTargetName: *void, fContextReq: u32, Reserved1: u32, TargetDataRep: u32, pInput: *SecBufferDesc, Reserved2: u32, phNewContext: *SecHandle, pOutput: *SecBufferDesc, pfContextAttr: mut* u32, ptsExpiry: *void) i32;

#[extern]
pub func QueryContextAttributesA(phContext: *SecHandle, ulAttribute: u32, pBuffer: *void) i32;

#[extern]
pub func EncryptMessage(phContext: *SecHandle, fQOP: u32, pMessage: *SecBufferDesc, MessageSeqNo: u32) i32;

#[extern]
pub func DecryptMessage(phContext: *SecHandle, pMessage: *SecBufferDesc, MessageSeqNo: u32, pfQOP: mut* u32) i32;

