#[cfg(target_os = "linux")]

mod std::sys;

import std::c::{from_cstring};

// Enums

pub enum FileFlags : i32 {
    ReadOnly    = 0,
    WriteOnly   = 1,
    Create      = 64,
    Truncate    = 512,
    Directory   = 65536,
    CloseOnExec = 524288,
}

impl FileFlags : BitOr[FileFlags] {
    type Result = FileFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

impl FileFlags : BitAnd[FileFlags] {
    type Result = FileFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as i32 & rhs as i32) as Self;
    }
}

pub enum LibFlags : i32 {
    Lazy     = 0x00001,
    Now      = 0x00002,
    NoLoad   = 0x00004,

    Global   = 0x00100,
    Local    = 0x0000,

    NoDelete = 0x01000,
}

impl LibFlags : BitNot {
    type Result = LibFlags;

    pub func bit_not(self) Result {
        return ~(*self as i32) as Self;
    }
}

impl LibFlags : BitOr[LibFlags] {
    type Result = LibFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

impl LibFlags : BitAnd[LibFlags] {
    type Result = LibFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as i32 & rhs as i32) as Self;
    }
}

pub enum IoctlOp : u64 {
    TIOCGWINSZ = 0x5413,
    TCGETS = 0x5401,
    TCSETS = 0x5402,
}

pub enum PollEvent : i16 {
    IN    = 0x0001,
    PRI   = 0x0002,
    OUT   = 0x0004,
    ERR   = 0x0008,
    HUP   = 0x0010,
    NVAL  = 0x0020,
}

impl PollEvent : BitNot {
    type Result = PollEvent;

    pub func bit_not(self) Result {
        return ~(*self as i16) as Self;
    }
}

impl PollEvent : BitOr[PollEvent] {
    type Result = PollEvent;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i16 | rhs as i16) as Self;
    }
}

impl PollEvent : BitAnd[PollEvent] {
    type Result = PollEvent;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as i16 & rhs as i16) as Self;
    }
}

pub enum InputFlags : u32 {
    IGNBRK  = 0x00001,
    BRKINT  = 0x00002,
    IGNPAR  = 0x00004,
    PARMRK  = 0x00008,
    INPCK   = 0x00010,
    ISTRIP  = 0x00020,
    INLCR   = 0x00040,
    IGNCR   = 0x00080,
    ICRNL   = 0x00100,
    IUCLC   = 0x00200,
    IXON    = 0x00400,
    IXANY   = 0x00800,
    IXOFF   = 0x01000,
    IMAXBEL = 0x02000,
    IUTF8   = 0x04000,
}

impl InputFlags : BitNot {
    type Result = InputFlags;

    pub func bit_not(self) Result {
        return ~(*self as u32) as Self;
    }
}

impl InputFlags : BitOr[InputFlags] {
    type Result = InputFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl InputFlags : BitAnd[InputFlags] {
    type Result = InputFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

pub enum OutputFlags : u32 {
    OPOST  = 0x00001,
    OLCUC  = 0x00002,
    ONLCR  = 0x00004,
    OCRNL  = 0x00008,
    ONOCR  = 0x00010,
    ONLRET = 0x00020,
    OFILL  = 0x00040,
    OFDEL  = 0x00080,
    NLDLY  = 0x00100,
    CRDLY  = 0x00600,
    CR1    = 0x00200,
    CR2    = 0x00400,
    TABDLY = 0x01800,
    TAB1   = 0x00800,
    TAB2   = 0x01000,
    BSDLY  = 0x02000,
    VTDLY  = 0x04000,
    FFDLY  = 0x08000,
}

impl OutputFlags : BitNot {
    type Result = OutputFlags;

    pub func bit_not(self) Result {
        return ~(*self as u32) as Self;
    }
}

impl OutputFlags : BitOr[OutputFlags] {
    type Result = OutputFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl OutputFlags : BitAnd[OutputFlags] {
    type Result = OutputFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

pub enum ControlFlags : u32 {
    CBAUD   = 0x0000100F,
    CSIZE   = 0x00000030,
    CS5     = 0x00000000,
    CS6     = 0x00000010,
    CS7     = 0x00000020,
    CSTOPB  = 0x00000040,
    CREAD   = 0x00000080,
    PARENB  = 0x00000100,
    PARODD  = 0x00000200,
    HUPCL   = 0x00000400,
    CLOCAL  = 0x00000800,
    CBAUDEX = 0x00001000,
    CIBAUD  = 0x100F0000,
    CMSPAR  = 0x40000000,
    CRTSCTS = 0x80000000,
}

impl ControlFlags : BitNot {
    type Result = ControlFlags;

    pub func bit_not(self) Result {
        return ~(*self as u32) as Self;
    }
}

impl ControlFlags : BitOr[ControlFlags] {
    type Result = ControlFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl ControlFlags : BitAnd[ControlFlags] {
    type Result = ControlFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

pub enum LocalFlags : u32 {
    ISIG    = 0x00001,
    ICANON  = 0x00002,
    XCASE   = 0x00004,
    ECHO    = 0x00008,
    ECHOE   = 0x00010,
    ECHOK   = 0x00020,
    ECHONL  = 0x00040,
    NOFLSH  = 0x00080,
    TOSTOP  = 0x00100,
    ECHOCTL = 0x00200,
    ECHOPRT = 0x00400,
    ECHOKE  = 0x00800,
    FLUSHO  = 0x01000,
    PENDIN  = 0x04000,
    IEXTEN  = 0x08000,
    EXTPROC = 0x10000,
}

impl LocalFlags : BitNot {
    type Result = LocalFlags;

    pub func bit_not(self) Result {
        return ~(*self as u32) as Self;
    }
}

impl LocalFlags : BitOr[LocalFlags] {
    type Result = LocalFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as u32 | rhs as u32) as Self;
    }
}

impl LocalFlags : BitAnd[LocalFlags] {
    type Result = LocalFlags;

    pub func bit_and(self, rhs: Self) Self {
        return (*self as u32 & rhs as u32) as Self;
    }
}

pub enum ControlChar : u32 {
    VINTR    = 0,
    VQUIT    = 1,
    VERASE   = 2,
    VKILL    = 3,
    VEOF     = 4,
    VTIME    = 5,
    VMIN     = 6,
    VSWTC    = 7,
    VSTART   = 8,
    VSTOP    = 9,
    VSUSP    = 10,
    VEOL     = 11,
    VREPRINT = 12,
    VDISCARD = 13,
    VWERASE  = 14,
    VLNEXT   = 15,
    VEOL2    = 16,
}

pub enum Domain : i32 {
    IP4 = 2,
    IP6 = 10,
}

pub enum Type : i32 {
    TCP = 1,
    UDP = 2,
}

pub enum Protocol : i32 {
    IP = 0,
}

// Structs

#[repr(C)]
pub struct Dirent64 {
    pub ino: u64,
    pub off: i64,
    pub reclen: u16,
    pub type_: u8,
}

impl Dirent64 {
    pub func name(self) StringView {
        return from_cstring(&(self as *u8)[offsetof(Dirent64, type_) + 1]);
    }
}

#[repr(C)]
pub struct Timespec {
    pub sec: i64,
    pub nsec: i64,
}

#[repr(C)]
pub struct Stat {
    pub dev: u64,
    pub ino: u64,
    pub nlink: u64,
    pub mode: u32,
    pub uid: u32,
    pub gid: u32,
    pub rdev: u64,
    pub size: u64,
    pub blksize: u64,
    pub blocks: u64,

    pub atim: Timespec,
    pub mtim: Timespec,
    pub ctim: Timespec,

    _pad: [3]u64,
}

#[repr(C)]
pub struct TimeSpec {
    pub tv_sec: i64,
    pub tv_nsec: i64,
}

#[repr(C)]
pub struct PollFd {
    pub fd: i32,
    pub req_events: PollEvent,
    pub ret_events: PollEvent,
}

#[repr(C)]
pub struct Termios {
    pub input_flags: InputFlags,
    pub output_flags: OutputFlags,
    pub control_flags: ControlFlags,
    pub local_flags: LocalFlags,
    pub line: u8,
    pub control_chars: [16]u8,
    pub input_speed: u32,
    pub output_speed: u32,
}

impl Termios {
    pub func control_char(mut self, char: ControlChar) mut &u8 {
        return &self.control_chars[char as u32];
    }
}

#[repr(C)]
pub struct WinSize {
    pub row: u16,
    pub col: u16,
    pub xpixel: u16,
    pub ypixel: u16,
}

#[repr(C)]
pub struct SocketAddress {
    pub domain: u16,
    port: u16,
    pub ip: [4]u8,

    _pad: [8]u8,
}

impl SocketAddress {
    pub func new(domain: Domain, ip: [4]u8, port: u16) Self {
        return Self {
            domain: domain as u16,
            port: ((port >> 8u) & 0xFF) | ((port & 0xFF) << 8u),
            ip: ip,
        };
    }

    pub func port(self) u16 {
        return ((self.port >> 8u) & 0xFF) | ((self.port & 0xFF) << 8u);
    }
}

#[repr(C)]
pub struct DnsEntry {
    pub flags: i32,
    pub family: Domain,
    pub socktype: Type,
    pub protocol: i32,
    pub addrlen: u32,
    pub addr: *SocketAddress,
    pub canonname: *u8,
    pub next: *DnsEntry,
}

// Posix functions

pub func getcwd(buffer: mut *u8, size: u64) *u8 {
    return syscall2u(79, buffer as u64, size) as *u8;
}

pub func mkdir(path: *u8, mode: u32) i32 {
    return syscall2i(83, path as u64, mode) as i32;
}

pub func rmdir(path: *u8) i32 {
    return syscall1i(84, path as u64) as i32;
}

pub func openat(fd: i32, path: *u8, flags: FileFlags, mode: i32) i32 {
    return syscall4i(257, u64(fd), path as u64, flags as u64, u64(mode)) as i32;
}

pub func close(fd: i32) i32 {
    return syscall1i(3, u64(fd)) as i32;
}

pub func getdents64(fd: i32, buffer: mut *void, size: u32) i32 {
    return syscall3i(217, u64(fd), buffer as u64, size) as i32;
}

pub func lseek(fd: i32, offset: i64, whence: i32) i64 {
    return syscall3i(8, u64(fd), u64(offset), u64(whence));
}

pub func read(fd: i32, buffer: mut* void, size: u64) i64 {
    return syscall3i(0, u64(fd), buffer as u64, size);
}

pub func write(fd: i32, data: *void, size: u64) i64 {
    return syscall3i(1, u64(fd), data as u64, size);
}

pub func fstatat(fd: i32, path: *u8, stat: mut *Stat, flags: i32) i32 {
    return syscall4i(262, u64(fd), path as u64, stat as u64, u64(flags)) as i32;
}

pub func fcntl(fd: i32, cmd: i32, arg: i32) i32 {
    return syscall3i(72, u64(fd), u64(cmd), u64(arg)) as i32;
}

pub func pipe(fds: mut *i32) i32 {
    return syscall1i(22, fds as u64) as i32;
}

pub func dup2(oldfd: i32, newfd: i32) i32 {
    return syscall2i(33, u64(oldfd), u64(newfd)) as i32;
}

pub func fork() i32 {
    return syscall0i(57) as i32;
}

pub func chdir(path: *u8) i32 {
    return syscall1i(80, path as u64) as i32;
}

pub func execve(file: *u8, argv: **u8, envp: **u8) i32 {
    return syscall3i(59, file as u64, argv as u64, envp as u64) as i32;
}

pub func waitpid(pid: i32, status: mut *i32, options: i32) i32 {
    return syscall4i(61, u64(pid), status as u64, u64(options), 0) as i32;
}

pub func exit(code: i32) {
    syscall1u(60, u64(code));
}

pub func clock_gettime(clk_id: i32, tp: mut* TimeSpec) i32 {
    return syscall2i(228, u64(clk_id), tp as u64) as i32;
}

pub func ioctl(fd: i32, op: IoctlOp, argp: mut *void) i32 {
    return syscall3i(16, u64(fd), op as u64, argp as u64) as i32;
}

pub func poll(fds: mut *PollFd, count: u32, timeout: i32) i32 {
    return syscall3i(7, fds as u64, count as u64, u64(timeout)) as i32;
}

pub func socket(domain: Domain, type_: Type, protocol: Protocol) i32 {
    return syscall3i(41, domain as u64, type_ as u64, protocol as u64) as i32;
}

pub func bind(fd: i32, addr: *SocketAddress, len: u32) i32 {
    return syscall3i(49, u64(fd), addr as u64, len) as i32;
}

pub func connect(fd: i32, addr: *SocketAddress, len: u32) i32 {
    return syscall3i(42, u64(fd), addr as u64, len) as i32;
}

pub func listen(fd: i32, backlog: i32) i32 {
    return syscall2i(50, u64(fd), u64(backlog)) as i32;
}

pub func accept(fd: i32, addr: mut* SocketAddress, len: mut* u32) i32 {
    return syscall3i(43, u64(fd), addr as u64, len as u64) as i32;
}

pub func send(fd: i32, buf: *void, len: u64, flags: i32) i64 {
    return syscall6i(44, u64(fd), buf as u64, len, u64(flags), 0, 0);
}

pub func recv(fd: i32, buf: mut* void, len: u64, flags: i32) i64 {
    return syscall6i(45, u64(fd), buf as u64, len, u64(flags), 0, 0);
}

// LibC

#[extern]
pub func dlopen(name: *u8, flags: LibFlags) *void;

#[extern]
pub func dlsym(handle: *void, name: *u8) *void;

#[extern]
pub func dlclose(handle: *void) i32;

#[extern]
pub func getaddrinfo(name: *u8, service: *u8, hints: *DnsEntry, result: mut **DnsEntry) i32;

#[extern]
pub func freeaddrinfo(result: *DnsEntry);

// Utils

pub func at_fdcwd() i32 {
    return -100;
}

// Syscalls

func u64(v: i64) u64 {
    return *(&v as *u64);
}

#[intrinsic(syscall)]
func syscall0i(num: u64) i64;
#[intrinsic(syscall)]
func syscall0u(num: u64) u64;

#[intrinsic(syscall)]
func syscall1i(num: u64, arg0: u64) i64;
#[intrinsic(syscall)]
func syscall1u(num: u64, arg0: u64) u64;

#[intrinsic(syscall)]
func syscall2i(num: u64, arg0: u64, arg1: u64) i64;
#[intrinsic(syscall)]
func syscall2u(num: u64, arg0: u64, arg1: u64) u64;

#[intrinsic(syscall)]
func syscall3i(num: u64, arg0: u64, arg1: u64, arg2: u64) i64;
#[intrinsic(syscall)]
func syscall3u(num: u64, arg0: u64, arg1: u64, arg2: u64) u64;

#[intrinsic(syscall)]
func syscall4i(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64) i64;
#[intrinsic(syscall)]
func syscall4u(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64) u64;

#[intrinsic(syscall)]
func syscall5i(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64) i64;
#[intrinsic(syscall)]
func syscall5u(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64) u64;

#[intrinsic(syscall)]
func syscall6i(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64) i64;
#[intrinsic(syscall)]
func syscall6u(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64) u64;
