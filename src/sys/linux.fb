#[cfg(target_os = "linux")]

mod std::sys;

// Enums

pub enum FileFlags : i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    Create = 64,
    Truncate = 512,
    CloseOnExec = 524288,
}

impl FileFlags : BitOr[FileFlags] {
    type Result = FileFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

pub enum LibFlags : i32 {
    Lazy = 0x00001,
    Now = 0x00002,
    NoLoad = 0x00004,

    Global = 0x00100,
    Local = 0x0000,

    NoDelete = 0x01000,
}

impl LibFlags : BitOr[LibFlags] {
    type Result = LibFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

pub enum Domain : i32 {
    IP4 = 2,
    IP6 = 10,
}

pub enum Type : i32 {
    TCP = 1,
    UDP = 2,
}

pub enum Protocol : i32 {
    IP = 0,
}

// Structs

#[repr(C)]
pub struct Dirent {
    pub ino: u64,
    pub off: i64,
    pub reclen: u16,
    pub type_: u8,
    pub name: [256]u8,
}

#[repr(C)]
pub struct Timespec {
    pub sec: i64,
    pub nsec: i64,
}

#[repr(C)]
pub struct Stat {
    pub dev: u64,
    pub ino: u64,
    pub nlink: u64,
    pub mode: u32,
    pub uid: u32,
    pub gid: u32,
    pub rdev: u64,
    pub size: u64,
    pub blksize: u64,
    pub blocks: u64,

    pub atim: Timespec,
    pub mtim: Timespec,
    pub ctim: Timespec,

    _pad: [3]u64,
}

#[repr(C)]
pub struct TimeSpec {
    pub tv_sec: i64,
    pub tv_nsec: i64,
}

#[repr(C)]
pub struct SocketAddress {
    pub domain: u16,
    port: u16,
    pub ip: [4]u8,

    _pad: [8]u8,
}

impl SocketAddress {
    pub func new(domain: Domain, ip: [4]u8, port: u16) Self {
        return Self {
            domain: domain as u16,
            port: ((port >> 8u) & 0xFF) | ((port & 0xFF) << 8u),
            ip: ip,
        };
    }

    pub func port(self) u16 {
        return ((self.port >> 8u) & 0xFF) | ((self.port & 0xFF) << 8u);
    }
}

#[repr(C)]
pub struct DnsEntry {
    pub flags: i32,
    pub family: Domain,
    pub socktype: Type,
    pub protocol: i32,
    pub addrlen: u32,
    pub addr: *SocketAddress,
    pub canonname: *u8,
    pub next: *DnsEntry,
}

// Posix functions

pub func getcwd(buffer: mut *u8, size: u64) *u8 {
    return syscall2u(79, buffer as u64, size) as *u8;
}

pub func mkdir(path: *u8, mode: u32) i32 {
    return syscall2i(83, path as u64, mode) as i32;
}

pub func rmdir(path: *u8) i32 {
    return syscall1i(84, path as u64) as i32;
}

#[extern]
pub func opendir(path: *u8) *void;

#[extern]
pub func readdir(dir: *void) *Dirent;

#[extern]
pub func closedir(dir: *void) i32;

pub func openat(fd: i32, path: *u8, flags: FileFlags, mode: i32) i32 {
    return syscall4i(257, u64(fd), path as u64, flags as u64, u64(mode)) as i32;
}

pub func close(fd: i32) i32 {
    return syscall1i(3, u64(fd)) as i32;
}

pub func lseek(fd: i32, offset: i64, whence: i32) i64 {
    return syscall3i(8, u64(fd), u64(offset), u64(whence));
}

pub func read(fd: i32, buffer: mut* void, size: u64) i64 {
    return syscall3i(0, u64(fd), buffer as u64, size);
}

pub func write(fd: i32, data: *void, size: u64) i64 {
    return syscall3i(1, u64(fd), data as u64, size);
}

pub func fstatat(fd: i32, path: *u8, stat: mut *Stat, flags: i32) i32 {
    return syscall4i(262, u64(fd), path as u64, stat as u64, u64(flags)) as i32;
}

pub func fcntl(fd: i32, cmd: i32, arg: i32) i32 {
    return syscall3i(72, u64(fd), u64(cmd), u64(arg)) as i32;
}

pub func pipe(fds: mut *i32) i32 {
    return syscall1i(22, fds as u64) as i32;
}

pub func dup2(oldfd: i32, newfd: i32) i32 {
    return syscall2i(33, u64(oldfd), u64(newfd)) as i32;
}

pub func fork() i32 {
    return syscall0i(57) as i32;
}

pub func chdir(path: *u8) i32 {
    return syscall1i(80, path as u64) as i32;
}

pub func execve(file: *u8, argv: **u8, envp: **u8) i32 {
    return syscall3i(59, file as u64, argv as u64, envp as u64) as i32;
}

pub func waitpid(pid: i32, status: mut *i32, options: i32) i32 {
    return syscall4i(61, u64(pid), status as u64, u64(options), 0) as i32;
}

pub func exit(code: i32) {
    syscall1u(60, u64(code));
}

pub func clock_gettime(clk_id: i32, tp: mut* TimeSpec) i32 {
    return syscall2i(228, u64(clk_id), tp as u64) as i32;
}

pub func socket(domain: Domain, type_: Type, protocol: Protocol) i32 {
    return syscall3i(41, domain as u64, type_ as u64, protocol as u64) as i32;
}

pub func bind(fd: i32, addr: *SocketAddress, len: u32) i32 {
    return syscall3i(49, u64(fd), addr as u64, len) as i32;
}

pub func connect(fd: i32, addr: *SocketAddress, len: u32) i32 {
    return syscall3i(42, u64(fd), addr as u64, len) as i32;
}

pub func listen(fd: i32, backlog: i32) i32 {
    return syscall2i(50, u64(fd), u64(backlog)) as i32;
}

pub func accept(fd: i32, addr: mut* SocketAddress, len: mut* u32) i32 {
    return syscall3i(43, u64(fd), addr as u64, len as u64) as i32;
}

pub func send(fd: i32, buf: *void, len: u64, flags: i32) i64 {
    return syscall6i(44, u64(fd), buf as u64, len, u64(flags), 0, 0);
}

pub func recv(fd: i32, buf: mut* void, len: u64, flags: i32) i64 {
    return syscall6i(45, u64(fd), buf as u64, len, u64(flags), 0, 0);
}

// LibC

#[extern]
pub func dlopen(name: *u8, flags: LibFlags) *void;

#[extern]
pub func dlsym(handle: *void, name: *u8) *void;

#[extern]
pub func dlclose(handle: *void) i32;

#[extern]
pub func getaddrinfo(name: *u8, service: *u8, hints: *DnsEntry, result: mut **DnsEntry) i32;

#[extern]
pub func freeaddrinfo(result: *DnsEntry);

// Utils

pub func at_fdcwd() i32 {
    return -100;
}

// Syscalls

func u64(v: i64) u64 {
    return *(&v as *u64);
}

#[intrinsic(syscall)]
func syscall0i(num: u64) i64;
#[intrinsic(syscall)]
func syscall0u(num: u64) u64;

#[intrinsic(syscall)]
func syscall1i(num: u64, arg0: u64) i64;
#[intrinsic(syscall)]
func syscall1u(num: u64, arg0: u64) u64;

#[intrinsic(syscall)]
func syscall2i(num: u64, arg0: u64, arg1: u64) i64;
#[intrinsic(syscall)]
func syscall2u(num: u64, arg0: u64, arg1: u64) u64;

#[intrinsic(syscall)]
func syscall3i(num: u64, arg0: u64, arg1: u64, arg2: u64) i64;
#[intrinsic(syscall)]
func syscall3u(num: u64, arg0: u64, arg1: u64, arg2: u64) u64;

#[intrinsic(syscall)]
func syscall4i(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64) i64;
#[intrinsic(syscall)]
func syscall4u(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64) u64;

#[intrinsic(syscall)]
func syscall5i(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64) i64;
#[intrinsic(syscall)]
func syscall5u(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64) u64;

#[intrinsic(syscall)]
func syscall6i(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64) i64;
#[intrinsic(syscall)]
func syscall6u(num: u64, arg0: u64, arg1: u64, arg2: u64, arg3: u64, arg4: u64, arg5: u64) u64;
