mod std;

import std::json::{Serialize, Serializer, Deserialize, Deserializer, TokenKind};
import std::c::{malloc, free};

pub struct ArrayList[T] {
    ptr: mut *T,
    size: u64,
    capacity: u64,
}

impl[T] ArrayList[T] {
    pub func with_capacity(capacity: u64) Self {
        var list: Self;
        list.ensure_capacity(capacity);

        return list;
    }

    pub func ensure_capacity(mut self, additional_size: u64) {
        if (self.size + additional_size <= self.capacity) return;

        var new_capacity = self.capacity * 2;
        if (new_capacity == 0) new_capacity = 8;
        if (new_capacity < self.size + additional_size) new_capacity = self.size + additional_size;

        var new_ptr = malloc(new_capacity * sizeof(T)) as mut* T;

        if (self.ptr != null) {
            memcpy(new_ptr, self.ptr, self.size * sizeof(T));
            free(self.ptr);
        }

        self.ptr = new_ptr;
        self.capacity = new_capacity;
    }

    pub func add(mut self, item: T) {
        self.ensure_capacity(1);
        self.ptr[self.size++] = item;
    }

    pub func add_all(mut self, items: []T) {
        self.ensure_capacity(items.size);

        memcpy(&self.ptr[self.size], items.ptr, items.size * sizeof(T));
        self.size += items.size;
    }

    pub func first(self) ?T {
        if (self.size == 0) return Option:[T]::none();
        return self.ptr[0];
    }

    pub func last(self) ?T {
        if (self.size == 0) return Option:[T]::none();
        return self.ptr[self.size - 1];
    }

    pub func truncate(mut self, size: u64) {
        if (size >= self.size) return;

        self.size = size;
    }

    pub func remove(mut self, index: u64) T {
        if (index >= self.size) {
            panic("ArrayList.remove() - invalid index");
        }

        var item = self.ptr[index];

        if (index < self.size - 1) memmove(&self.ptr[index], &self.ptr[index + 1u], (self.size - index - 1u) * sizeof(T));
        self.size--;

        return item;
    }

    pub func remove_first(mut self) T {
        return self.remove(0);
    }

    pub func remove_last(mut self) T {
        return self.remove(self.size - 1);
    }

    pub func clear(mut self) {
        self.size = 0;
    }

    pub func size(self) u64 {
        return self.size;
    }

    pub func capacity(self) u64 {
        return self.capacity;
    }

    pub func get_ptr(mut self, index: u64) mut* T {
        return &self.ptr[index];
    }

    pub func free(mut self) {
        if (self.ptr == null) return;

        free(self.ptr);

        self.ptr = null;
        self.size = 0;
        self.capacity = 0;
    }

    pub func as_mut_slice(mut self) mut []T {
        return MutSlice:[T] { ptr: self.ptr, size: self.size };
    }
}

impl[T: Eq[T]] ArrayList[T] {
	pub func index_of(self, value: T) ?u64 {
		for (var i = 0u; i < self.size; i++) {
			if (self.ptr[i] == value) return i;
		}

		return Option:[u64]::none();
	}

	pub func contains(self, value: T) bool {
		return self.index_of(value).is_some();
	}
}

impl[T: Eq[T]] ArrayList[T] : Eq[[]T] {
	pub func eq(self, rhs: []T) bool {
		if (self.size != rhs.size) return false;

		for (var i = 0u; i < self.size; i++) {
			if (self.ptr[i] != rhs.ptr[i]) return false;
		}

		return true;
	}
}

impl[T: Ord[T]] ArrayList[T] : Ord[[]T] {
    pub func ord(self, rhs: []T) Ordering {
        return (*self as []T).ord(rhs);
    }
}

impl[T] ArrayList[T] : Index[u64] {
    type Result = T;

    pub func index(self, i: u64) T {
        return self.ptr[i];
    }
}

impl[T] ArrayList[T] : ImplicitAs[[]T] {
    pub func implicit_as(self) []T {
        return Slice:[T] { ptr: self.ptr, size: self.size };
    }
}

impl[T] ArrayList[T] : Serialize {
    pub func serialize(self, se: mut& Serializer) {
        se.array_start();

        for (var i = 0u; i < self.size; i++) {
            se.serialize(&self.ptr[i], typeof(T));
        }

        se.array_end();
    }
}

impl[T: Zeroable] ArrayList[T] : Deserialize {
    pub func deserialize(mut self, de: mut& Deserializer) ?bool {
        de.array_start()?;

        for (;;) {
            var kind = de.peek()?.kind;
            if (kind == TokenKind::EOF || kind == TokenKind::ArrayEnd) break;

            var item: T;
            de.deserialize(&item, typeof(T))?;

            self.add(item);
        }

        de.array_end()?;
        return true;
    }
}
