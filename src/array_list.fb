mod std;

import std::c::{malloc, free, memcpy, memmove};

pub struct ArrayList[T] {
    ptr: mut *T,
    size: u64,
    capacity: u64,
}

impl[T] ArrayList[T] {
    pub func ensure_capacity(mut self, additional_size: u64) {
        if (self.size + additional_size <= self.capacity) return;

        var new_capacity = self.capacity * 2u;
        if (new_capacity == 0u) new_capacity = 8u;
        if (new_capacity < self.size + additional_size) new_capacity = self.size + additional_size;

        var new_ptr = malloc(new_capacity * sizeof(T)) as mut* T;

        if (self.ptr != null) {
            memcpy(new_ptr, self.ptr, self.size * sizeof(T));
            free(self.ptr);
        }

        self.ptr = new_ptr;
        self.capacity = new_capacity;
    }

    pub func add(mut self, item: T) {
        self.ensure_capacity(1u);
        self.ptr[self.size++] = item;
    }

    pub func add_all(mut self, items: []T) {
        self.ensure_capacity(items.size);

        memcpy(&self.ptr[self.size], items.ptr, items.size * sizeof(T));
        self.size += items.size;
    }

    pub func remove(mut self, index: u64) {
        memmove(&self.ptr[index], &self.ptr[index + 1u], (self.size - index - 1u) * sizeof(T));
        self.size--;
    }

    pub func size(self) u64 {
        return self.size;
    }

    pub func get_ptr(mut self, index: u64) mut* T {
        return &self.ptr[index];
    }

    pub func free(mut self) {
        if (self.ptr == null) return;

        free(self.ptr);

        self.ptr = null;
        self.size = 0u;
        self.capacity = 0u;
    }

    pub func as_mut_slice(mut self) mut []T {
        return MutSlice:[T] { ptr: self.ptr, size: self.size };
    }
}

impl[T] ArrayList[T] : Index[u64] {
    type Result = T;

    pub func index(self, i: u64) T {
        return self.ptr[i];
    }
}

impl[T] ArrayList[T] : ImplicitAs[[]T] {
    pub func implicit_as(self) []T {
        return Slice:[T] { ptr: self.ptr, size: self.size };
    }
}
