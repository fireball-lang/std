mod std::term;

import std::term::{Event, KeyEvent, Key, Modifier, ButtonEvent, Action, Button, MotionEvent};

pub struct AnsiResult {
    /// If this field is true, `event` is going to be `None` and `consumed` 0,
    /// the caller should wait for more data before trying to parse again.
    pub incomplete: bool,

    /// The parsed event, if `None` then it is an unknown event,
    /// and the caller should skip over the consumed bytes.
    pub event: ?Event,

    /// How many bytes were consumed to parse this ANSI sequence.
    pub consumed: u32,
}

/// Parses an ANSI event from the provided bytes.
///
/// **NOTE:** a lone `\x1b` is returned as `incomplete: true`.
/// The caller should decide if to wait for more data or manually construct an `Esc` key event.
pub func parse_ansi_event(bytes: []u8) AnsiResult {
    if (bytes.size == 0) return AnsiResult { incomplete: true };
    var b = bytes[0];

    // 1. Escape sequenses
    if (b == 0x1B) {
        return parse_escape_sequence(bytes);
    }

    // 2. Control Characters (0x00 to 0x1F)
    if (b == 0x0D) return new_key_event(Key::Enter, Modifier::None, 1);
    if (b == 0x09) return new_key_event(Key::Tab, Modifier::None, 1);
    if (b == 0x7F || b == 0x08) return new_key_event(Key::Backspace, Modifier::None, 1);

    // Ctrl+A to Ctrl+Z
    if (b >= 0x01 && b <= 0x1A) {
        return AnsiResult {
            event: Event::new_key(KeyEvent {
                key: Key::Char,
                char: b - 1 + 'a',
                mods: Modifier::Ctrl,
            }),
            consumed: 1,
        };
    }

    // 3. Normal Printable Characters
    var needed_bytes: u32 = 0;
    var codepoint: u32 = 0;

    // Determine how many bytes this character uses based on the first byte
    if ((b & 0x80) == 0) {         // 0xxxxxxx (ASCII)
        codepoint = b as u32;
        needed_bytes = 1;
    }
    else if ((b & 0xE0) == 0xC0) { // 110xxxxx (2-byte sequence)
        codepoint = (b & 0x1F) as u32;
        needed_bytes = 2;
    }
    else if ((b & 0xF0) == 0xE0) { // 1110xxxx (3-byte sequence)
        codepoint = (b & 0x0F) as u32;
        needed_bytes = 3;
    }
    else if ((b & 0xF8) == 0xF0) { // 11110xxx (4-byte sequence)
        codepoint = (b & 0x07) as u32;
        needed_bytes = 4;
    }
    else {
        // Invalid UTF-8 start byte
        return AnsiResult { consumed: 1 };
    }

    if (bytes.size < needed_bytes) return AnsiResult { incomplete: true };

    // Read the continuation bytes
    var i: u32 = 1;

    while (i < needed_bytes) {
        var next_b = bytes[i];

        if ((next_b & 0xC0) != 0x80) {
            // Invalid continuation byte
            return AnsiResult { consumed: i };
        }

        codepoint = (codepoint << 6) | ((next_b & 0x3F) as u32);
        i += 1;
    }

    return AnsiResult {
        event: Event::new_key(KeyEvent {
            key: Key::Char,
            char: codepoint,
            mods: Modifier::None,
        }),
        consumed: needed_bytes,
    };
}

func parse_escape_sequence(bytes: []u8) AnsiResult {
    if (bytes.size == 1) return AnsiResult { incomplete: true };

    // CSI sequence
    if (bytes[1] == '[') {
        return parse_csi_sequence(bytes);
    }

    // SS3 sequence
    if (bytes[1] == 'O') {
        if (bytes.size == 2) return AnsiResult { incomplete: true };
        var b = bytes[2];

        if (b == 'P') return new_key_event(Key::F1, Modifier::None, 3);
        if (b == 'Q') return new_key_event(Key::F2, Modifier::None, 3);
        if (b == 'R') return new_key_event(Key::F3, Modifier::None, 3);
        if (b == 'S') return new_key_event(Key::F4, Modifier::None, 3);

        return AnsiResult { consumed: 3 };
    }

    // Alt + Key
    return AnsiResult {
        event: Event::new_key(KeyEvent {
            key: Key::Char,
            char: bytes[1],
            mods: Modifier::Alt,
        }),
        consumed: 2,
    };
}

func parse_csi_sequence(bytes: []u8) AnsiResult {
    // 1. Scan for the terminating byte
    var end_idx: u32 = 0;
    var i: u32 = 2;

    while (i < bytes.size) {
        var b = bytes[i];

        // An ANSI terminator is any byte from 0x40 to 0x7E
        if (b >= 0x40 && b <= 0x7E) {
            end_idx = i;
            break;
        }

        i += 1;
    }

    // 2. If we didn't find the terminator, we need more data
    if (end_idx == 0) return AnsiResult { incomplete: true };

    var consumed = end_idx + 1;
    var terminator = bytes[end_idx];

    if (end_idx > 2 && bytes[2] == '<') {
        return parse_sgr_mouse_sequence(bytes, end_idx, consumed);
    }

    // 3. Parse parameters (numbers separated by ';')
    var p1: u32 = 1;
    var p2: u32 = 1;
    var is_p2: bool = false;
    var current_num: u32 = 0;
    var has_num: bool = false;

    var j: u32 = 2;

    while (j < end_idx) {
        var b = bytes[j];

        if (b >= '0' && b <= '9') {
            current_num = (current_num * 10) + ((b - '0') as u32);
            has_num = true;
        }
        else if (b == ';') {
            if (is_p2) p2 = current_num;
            else p1 = current_num;

            is_p2 = true;
            current_num = 0;
            has_num = false;
        }

        j += 1;
    }

    // Apply the very last number parsed
    if (has_num) {
        if (is_p2) p2 = current_num;
        else p1 = current_num;
    }

    // 4. Decode the modifiers and map the keys
    var mods = decode_modifier(p2);

    if (terminator == 'I') return AnsiResult { event: Event::new_focus_gained(), consumed: consumed };
    if (terminator == 'O') return AnsiResult { event: Event::new_focus_lost(), consumed: consumed };

    if (terminator == 'A') return new_key_event(Key::Up, mods, consumed);
    if (terminator == 'B') return new_key_event(Key::Down, mods, consumed);
    if (terminator == 'C') return new_key_event(Key::Right, mods, consumed);
    if (terminator == 'D') return new_key_event(Key::Left, mods, consumed);
    if (terminator == 'H') return new_key_event(Key::Home, mods, consumed);
    if (terminator == 'F') return new_key_event(Key::End, mods, consumed);

    // Note: F1-F4 are normally SS3 (e.g., \x1bOP), but if a user presses Shift+F1,
    // many terminals switch to CSI and send \x1b[1;2P
    if (terminator == 'P') return new_key_event(Key::F1, mods, consumed);
    if (terminator == 'Q') return new_key_event(Key::F2, mods, consumed);
    if (terminator == 'R') return new_key_event(Key::F3, mods, consumed);
    if (terminator == 'S') return new_key_event(Key::F4, mods, consumed);

    // Tilde (~) sequences are defined by the `p1` parameter
    if (terminator == '~') {
        if (p1 == 1 || p1 == 7) return new_key_event(Key::Home, mods, consumed);
        if (p1 == 2) return new_key_event(Key::Insert, mods, consumed);
        if (p1 == 3) return new_key_event(Key::Delete, mods, consumed);
        if (p1 == 4 || p1 == 8) return new_key_event(Key::End, mods, consumed);
        if (p1 == 5) return new_key_event(Key::PageUp, mods, consumed);
        if (p1 == 6) return new_key_event(Key::PageDown, mods, consumed);

        if (p1 == 11) return new_key_event(Key::F1, mods, consumed);
        if (p1 == 12) return new_key_event(Key::F2, mods, consumed);
        if (p1 == 13) return new_key_event(Key::F3, mods, consumed);
        if (p1 == 14) return new_key_event(Key::F4, mods, consumed);
        if (p1 == 15) return new_key_event(Key::F5, mods, consumed);
        if (p1 == 17) return new_key_event(Key::F6, mods, consumed);
        if (p1 == 18) return new_key_event(Key::F7, mods, consumed);
        if (p1 == 19) return new_key_event(Key::F8, mods, consumed);
        if (p1 == 20) return new_key_event(Key::F9, mods, consumed);
        if (p1 == 21) return new_key_event(Key::F10, mods, consumed);
        if (p1 == 23) return new_key_event(Key::F11, mods, consumed);
        if (p1 == 24) return new_key_event(Key::F12, mods, consumed);
    }

    // Unrecognized sequence
    return AnsiResult { consumed: consumed };
}

func parse_sgr_mouse_sequence(bytes: []u8, end_idx: u32, consumed: u32) AnsiResult {
    var terminator = bytes[end_idx];

    if (terminator != 'M' && terminator != 'm') {
        return AnsiResult { consumed: consumed };
    }

    // 1. Parse the three parameters
    var cb: u32 = 0;
    var cx: u32 = 0;
    var cy: u32 = 0;

    var param_idx: u32 = 0;
    var current_num: u32 = 0;
    var has_num: bool = false;

    var j: u32 = 3;

    while (j < end_idx) {
        var b = bytes[j];

        if (b >= '0' && b <= '9') {
            current_num = (current_num * 10) + ((b - '0') as u32);
            has_num = true;
        }
        else if (b == ';') {
            if (param_idx == 0) cb = current_num;
            else if (param_idx == 1) cx = current_num;

            param_idx += 1;
            current_num = 0;
            has_num = false;
        }

        j += 1;
    }

    // Apply the final number (which is cy)
    if (has_num) {
        if (param_idx == 1) cx = current_num;
        else if (param_idx == 2) cy = current_num;
    }

    // 2. Decode the `cb` bitmask
    var mods = Modifier::None;

    if ((cb & 4) != 0) mods = mods | Modifier::Shift;
    if ((cb & 8) != 0) mods = mods | Modifier::Alt;
    if ((cb & 16) != 0) mods = mods | Modifier::Ctrl;

    var is_press = terminator == 'M';
    var is_motion_bit = (cb & 32) != 0;
    var is_scroll = (cb & 64) != 0;
    var button_code = cb & 3;

    // Convert terminal coordinates
    var x0: u16 = 0;
    if (cx > 0) x0 = (cx - 1) as u16;

    var y0: u16 = 0;
    if (cy > 0) y0 = (cy - 1) as u16;

    // 3. Check for Pure Motion Event
    // If the movement bit is set AND the button code is 3 (None), it's pure hovering.
    if (is_motion_bit && button_code == 3) {
        return AnsiResult {
            event: Event::new_motion(MotionEvent {
                x: x0,
                y: y0,
            }),
            consumed: consumed,
        };
    }

    // 4. Handle Button Events (Press, Drag, Release, Scroll)
    var button = Button::None;
    var action = Action::Press;

    if (is_scroll) {
        // Scroll events always report as 'Pressed'
        if (button_code == 0) button = Button::ScrollUp;
        else if (button_code == 1) button = Button::ScrollDown;
    } else {
        // Map Standard Buttons
        if (button_code == 0) button = Button::Left;
        else if (button_code == 1) button = Button::Middle;
        else if (button_code == 2) button = Button::Right;
        else if (button_code == 3) button = Button::None;

        // Map Action
        if (!is_press) {
            action = Action::Release;
        } else if (is_motion_bit) {
            action = Action::Drag;
        }
    }

    return AnsiResult {
        event: Event::new_button(ButtonEvent {
            action: action,
            button: button,
            mods: mods,
            x: x0,
            y: y0,
        }),
        consumed: consumed,
    };
}

func decode_modifier(val: u32) Modifier {
    var mods = Modifier::None;
    if (val <= 1) return mods;

    var bitmask = val - 1;

    if ((bitmask & 1) != 0) mods = mods | Modifier::Shift;
    if ((bitmask & 2) != 0) mods = mods | Modifier::Alt;
    if ((bitmask & 4) != 0) mods = mods | Modifier::Ctrl;

    return mods;
}

func new_key_event(key: Key, mods: Modifier, consumed: u32) AnsiResult {
    return AnsiResult {
        event: Event::new_key(KeyEvent {
            key: key,
            mods: mods
        }),
        consumed: consumed,
    };
}
