#[cfg(target_family = "windows")]

mod std::net::windows;

import std::c::{printf};
import std::sys;

var wsa_initialized: bool;

func ensure_wsa_initialized() {
    if (wsa_initialized) return;

    var data: sys::WsaData;
    var error = sys::wsa_startup(2u, &data);

    if (error != 0) {
        panic("Failed to initialize WinSock2");
    }

    wsa_initialized = true;
}

pub struct SocketFd {
    fd: u64,
}

impl SocketFd {
    pub func new(domain: sys::Domain, type_: sys::Type, protocol: sys::Protocol) ?Self {
        ensure_wsa_initialized();

        var fd = sys::socket(domain, type_, protocol);
        if (fd == 0xFFFFFFFFFFFFFFFF) return Option:[Self]::none();

        return Self { fd: fd };
    }

    pub func connect(address: sys::SocketAddress) ?Self {
        var fd = Self::new(address.domain as sys::Domain, sys::Type::TCP, sys::Protocol::IP)?;

        if (sys::connect(fd.fd, &address, sizeof(sys::SocketAddress) as i32) < 0) {
            fd.close();
            return Option:[Self]::none();
        }

        return fd;
    }

    pub func listen(address: sys::SocketAddress) ?Self {
        var fd = Self::new(address.domain as sys::Domain, sys::Type::TCP, sys::Protocol::IP)?;

        if (sys::bind(fd.fd, &address, sizeof(sys::SocketAddress) as i32) < 0) {
            fd.close();
            return Option:[Self]::none();
        }
        else if (sys::listen(fd.fd, 64) < 0) {
            fd.close();
            return Option:[Self]::none();
        }

        return fd;
    }

    pub func is_open(self) bool {
        return self.fd != 0xFFFFFFFFFFFFFFFF;
    }

    pub func accept(self, address: mut* sys::SocketAddress, address_len: mut* u32) ?Self {
        var address_len_i32 = *address_len as i32;

        var fd = sys::accept(self.fd, address, &address_len_i32);
        if (fd == 0xFFFFFFFFFFFFFFFF) return Option:[Self]::none();

        *address_len = address_len_i32 as u32;

        return Self { fd: fd };
    }

    pub func send(mut self, data: []u8) ?u64 {
        if (data.size > 2_147_483_647u) data = data.slice(0u, 2_147_483_647u);

        // Send
        if (data.size == 0u) return 0u;
        var sent = sys::send(self.fd, data.ptr, data.size as i32, 0);

        // Some amount of bytes sent
        if (sent > 0) {
            return sent as u64;
        }

        // Error
        return Option:[u64]::none();
    }

    pub func receive(mut self, buffer: mut []u8) ?u64 {
        if (buffer.size > 2_147_483_647u) buffer = buffer.slice(0u, 2_147_483_647u);

        // Receive
        if (buffer.size == 0u) return 0u;
        var read = sys::recv(self.fd, buffer.ptr, buffer.size as i32, 0);

        // Some amount of bytes read
        if (read > 0) {
            return read as u64;
        }

        // EOF
        if (read == 0) {
            return 0u;
        }

        // Error
        return Option:[u64]::none();
    }

    pub func close(mut self) {
        if (self.is_open()) {
            sys::closesocket(self.fd);
            self.fd = 0xFFFFFFFFFFFFFFFF;
        }
    }
}
