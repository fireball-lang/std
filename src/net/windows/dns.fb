#[cfg(target_family = "windows")]

mod std::net::windows;

import std::net::windows::{ensure_wsa_initialized};
import std::sys;

pub func getaddrinfo(name: *u8, service: *u8, hints: *sys::DnsEntry, result: mut **sys::DnsEntry) i32 {
    ensure_wsa_initialized();
    return sys::getaddrinfo(name, service, hints, result);
}
