mod std::net::http;

import std::net::{TlsSocket, Socket};
import std::io::{Reader, Writer};

struct HttpSocket {
    is_tls: bool,
    tls: TlsSocket,
    normal: Socket,
}

impl HttpSocket {
    func close(mut self) {
        if (self.is_tls) self.tls.close();
        else self.normal.close();
    }
}

impl HttpSocket : Reader {
    func read(mut self, buffer: mut []u8) ?u64 {
        if (self.is_tls) {
            return self.tls.read(buffer);
        }

        return self.normal.read(buffer);
    }
}

impl HttpSocket : Writer {
    func write(mut self, data: []u8) ?u64 {
        if (self.is_tls) {
            return self.tls.write(data);
        }

        return self.normal.write(data);
    }
}
