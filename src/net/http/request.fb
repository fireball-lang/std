mod std::net::http;

import std::net::http::{Method, HeaderMap};
import std::net::{Uri};

/// An HTTP request, constructed via `get` / `post` / `put` / `delete` and sent via `Client::send`.
///
/// The `Host`, `User-Agent`, `Accept`, `Accept-Encoding`, `Connection` and `Content-Length`
/// headers are filled in automatically by `Client` if not already set on the request.
/// Owns its `headers` map; call `close` to release it. The `body` slice is borrowed from
/// the caller and is not freed by `close`.
pub struct Request {
    pub method: Method,
    pub uri: Uri,
    pub headers: HeaderMap,

    pub body: []u8,
}

impl Request {
    /// Creates a `GET` request for `url`.
    /// Returns `None` if `url` cannot be parsed as a URI.
    pub func get(url: StringView) ?Self {
        return Self {
            method: Method::GET,
            uri: Uri::parse(url)?,
        };
    }

    /// Creates a `DELETE` request for `url`.
    /// Returns `None` if `url` cannot be parsed as a URI.
    pub func delete(url: StringView) ?Self {
        return Self {
            method: Method::DELETE,
            uri: Uri::parse(url)?,
        };
    }

    /// Creates a `PUT` request for `url` with the given `body`.
    /// `body` is borrowed, not copied. Returns `None` if `url` cannot be parsed as a URI.
    pub func put(url: StringView, body: []u8) ?Self {
        return Self {
            method: Method::PUT,
            uri: Uri::parse(url)?,
            body: body,
        };
    }

    /// Creates a `POST` request for `url` with the given `body`.
    /// `body` is borrowed, not copied. Returns `None` if `url` cannot be parsed as a URI.
    pub func post(url: StringView, body: []u8) ?Self {
        return Self {
            method: Method::POST,
            uri: Uri::parse(url)?,
            body: body,
        };
    }

    /// Frees the request's `headers` map. Does not free `body`.
    pub func close(mut self) {
        self.headers.free();
    }
}
