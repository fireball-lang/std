mod std::net::http;

import std::{ArrayList};

pub struct HeaderValue {
    pub value: StringView,
}

impl HeaderValue {
    pub func ptr(self) *u8 {
        return self.value.ptr;
    }

    pub func size(self) u32 {
        return self.value.size;
    }
}

impl HeaderValue : Eq[StringView] {
    pub func eq(self, rhs: StringView) bool {
        return case_insensitive_eq(self.value, rhs);
    }
}

impl HeaderValue : ImplicitAs[StringView] {
    pub func implicit_as(self) StringView {
        return self.value;
    }
}

pub struct Header {
    pub key: StringView,
    pub value: HeaderValue,
}

impl Header {
    pub func key_eq(self, key: StringView) bool {
        return case_insensitive_eq(self.key, key);
    }
}

pub struct HeaderMap {
    headers: ArrayList[Header],
}

impl HeaderMap {
    pub func insert(mut self, key: StringView, value: StringView) {
        for (var i = 0u; i < self.headers.size(); i++) {
            var item = self.headers.get_ptr(i);

            if (case_insensitive_eq(item.key, key)) {
                item.value = HeaderValue { value: value };
                return;
            }
        }

        self.headers.add(Header {
            key: key,
            value: HeaderValue { value: value },
        });
    }

    pub func try_get(self, key: StringView, value: mut* HeaderValue) bool {
        for (var i = 0u; i < self.headers.size(); i++) {
            var item = self.headers.get_ptr(i);

            if (case_insensitive_eq(item.key, key)) {
                *value = item.value;
                return true;
            }
        }

        return false;
    }

    pub func get(self, key: StringView) HeaderValue {
        var value: HeaderValue;
        var ok = self.try_get(key, &value);

        return value;
    }

    pub func contains(self, key: StringView) bool {
        for (var i = 0u; i < self.headers.size(); i++) {
            if (case_insensitive_eq(self.headers[i].key, key)) {
                return true;
            }
        }

        return false;
    }

    pub func remove(mut self, key: StringView) HeaderValue {
        for (var i = 0u; i < self.headers.size(); i++) {
            var item = self.headers.get_ptr(i);

            if (case_insensitive_eq(item.key, key)) {
                var value = item.value;
                self.headers.remove(i);
                return value;
            }
        }

        return HeaderValue {};
    }

    pub func size(self) u64 {
        return self.headers.size();
    }

    pub func get_at(self, index: u32) Header {
        return self.headers[index];
    }

    pub func free(mut self) {
        self.headers.free();
    }
}

impl HeaderMap : Index[StringView] {
    type Result = HeaderValue;

    pub func index(self, i: StringView) HeaderValue {
        var value: HeaderValue;
        if (!self.try_get(i, &value)) panic("ArrayMap::[] - value not found");

        return value;
    }
}

func case_insensitive_eq(a: StringView, b: StringView) bool {
    if (a.size != b.size) return false;

    for (var i = 0u; i < a.size; i++) {
        if (to_lower(a.ptr[i]) != to_lower(b.ptr[i])) return false;
    }

    return true;
}

func to_lower(ch: u8) u8 {
    if (ch >= 'A' && ch <= 'Z') return ch - 'A' + 'a';
    return ch;
}
