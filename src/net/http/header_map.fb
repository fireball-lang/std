mod std::net::http;

import std::{ArrayList};

/// Value of an HTTP header, accessible as a `StringView` with case-insensitive equality.
pub struct HeaderValue {
    pub value: StringView,
}

impl HeaderValue {
    /// Returns a pointer to the start of the value bytes.
    pub func ptr(self) *u8 {
        return self.value.ptr;
    }

    /// Returns the number of bytes in the value.
    pub func size(self) u32 {
        return self.value.size;
    }
}

impl HeaderValue : Eq[StringView] {
    pub func eq(self, rhs: StringView) bool {
        return case_insensitive_eq(self.value, rhs);
    }
}

impl HeaderValue : ImplicitAs[StringView] {
    pub func implicit_as(self) StringView {
        return self.value;
    }
}

/// A single header entry, consisting of a `key` and its `value`.
pub struct Header {
    pub key: StringView,
    pub value: HeaderValue,
}

impl Header {
    /// Returns `true` if this header's key matches `key`, ignoring ASCII case.
    pub func key_eq(self, key: StringView) bool {
        return case_insensitive_eq(self.key, key);
    }
}

/// A case-insensitive, insertion-ordered map of HTTP headers.
///
/// Keys are compared case-insensitively per RFC 9110. Inserting a key that already exists
/// overwrites the previous value rather than adding a duplicate.
pub struct HeaderMap {
    headers: ArrayList[Header],
}

impl HeaderMap {
    func find(self, key: StringView) *HeaderValue {
        for (var i = 0u; i < self.headers.size(); i++) {
            var item = &self.headers[i];

            if (case_insensitive_eq(item.key, key)) {
                return &item.value;
            }
        }

        return null;
    }

    func find_mut(mut self, key: StringView) mut *HeaderValue {
        for (var i = 0u; i < self.headers.size(); i++) {
            var item = &self.headers[i];

            if (case_insensitive_eq(item.key, key)) {
                return &item.value;
            }
        }

        return null;
    }

    /// Inserts `value` under `key`, replacing the value if `key` is already present.
    pub func insert(mut self, key: StringView, value: StringView) {
        var ptr = self.find_mut(key);

        if (ptr != null) {
            *ptr = HeaderValue { value: value};
            return;
        }

        self.headers.add(Header {
            key: key,
            value: HeaderValue { value: value},
        });
    }

    /// Looks up `key` and stores the value in `*value` if present.
    /// Returns `true` if the key was found, `false` otherwise.
    pub func try_get(self, key: StringView, value: mut* HeaderValue) bool {
        for (var i = 0u; i < self.headers.size(); i++) {
            var item = &self.headers[i];

            if (case_insensitive_eq(item.key, key)) {
                *value = item.value;
                return true;
            }
        }

        return false;
    }

    /// Looks up `key`, returning a default-initialized `HeaderValue` if it is absent.
    pub func get(self, key: StringView) HeaderValue {
        var value: HeaderValue;
        self.try_get(key, &value);

        return value;
    }

    /// Returns `true` if the map contains `key` (case-insensitive).
    pub func contains(self, key: StringView) bool {
        for (var i = 0u; i < self.headers.size(); i++) {
            if (case_insensitive_eq(self.headers[i].key, key)) {
                return true;
            }
        }

        return false;
    }

    /// Removes `key` and returns its previous value, or a default-initialized `HeaderValue` if absent.
    pub func remove(mut self, key: StringView) HeaderValue {
        for (var i = 0u; i < self.headers.size(); i++) {
            var item = &self.headers[i];

            if (case_insensitive_eq(item.key, key)) {
                var value = item.value;
                self.headers.remove(i);
                return value;
            }
        }

        return HeaderValue {};
    }

    /// Returns the number of header entries.
    pub func size(self) u64 {
        return self.headers.size();
    }

    /// Returns the header at the given insertion-order index. Panics if `index >= size`.
    pub func get_at(self, index: u32) Header {
        return self.headers[index];
    }

    /// Frees the map's backing storage. The map must not be used afterwards.
    pub func free(mut self) {
        self.headers.free();
    }
}

impl HeaderMap : Index[StringView] {
    type Result = HeaderValue;

    /// Looks up `key`. Panics if it is not present.
    pub func index(self, i: StringView) &HeaderValue {
        var ptr = self.find(i);
        if (ptr == null) panic("ArrayMap::[] - value not found");

        return ptr as &HeaderValue;
    }
}

impl HeaderMap : IndexMut[StringView] {
    type Result = HeaderValue;

    /// Looks up `key`. Panics if it is not present.
    pub func index_mut(mut self, i: StringView) mut &HeaderValue {
        var ptr = self.find(i);
        if (ptr == null) panic("ArrayMap::[] - value not found");

        return ptr as mut &HeaderValue;
    }
}

func case_insensitive_eq(a: StringView, b: StringView) bool {
    if (a.size != b.size) return false;

    for (var i = 0u; i < a.size; i++) {
        if (to_lower(a[i]) != to_lower(b[i])) return false;
    }

    return true;
}

func to_lower(ch: u8) u8 {
    if (ch >= 'A' && ch <= 'Z') return ch - 'A' + 'a';
    return ch;
}
