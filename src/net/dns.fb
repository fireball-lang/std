mod std::net;

#[cfg(target_family = "windows")]
import std::net::windows::{getaddrinfo};
#[cfg(target_family = "unix")]
import std::net::unix::{getaddrinfo};

import std::sys::{DnsEntry, Domain, Type, freeaddrinfo};

import std::c::{to_cstring, free, printf};

pub func resolve_domain(domain: StringView, buffer: mut [][4]u8) u32 {
    var hints = DnsEntry {
        family:   Domain::IP4,
        socktype: Type::TCP,
    };

    var results: *DnsEntry;

    var domain_cstr = to_cstring(domain);
    var ret = getaddrinfo(domain_cstr, null, &hints, &results);
    free(domain_cstr);

    if (ret != 0) return 0;

    var entry = results;
    var count = 0u;

    while (entry != null && count < buffer.size) {
        buffer.ptr[count++] = entry.addr.ip;
        entry = entry.next;
    }

    freeaddrinfo(results);
    return count;
}
