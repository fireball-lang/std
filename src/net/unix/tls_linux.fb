#[cfg(target_os = "linux")]

mod std::net::unix;

import std::net::unix::{SocketFd};
import std::c::{to_cstring, free};
import std::os::{Library};
import std::sys;

// OpenSSL

struct Method {}
struct SslCtx {}
struct Ssl {}
struct X509_VERIFY_PARAM {}

struct OpenSSL {
    client_method: func() *Method,
    ctx_new: func(*Method) *SslCtx,
    ctx_free: func(*SslCtx),
    ctx_set_default_verify_paths: func(*SslCtx) i32,
    ctx_set_verify: func(*SslCtx, i32, *void),
    ssl_new: func(*SslCtx) *Ssl,
    ssl_free: func(*Ssl),
    ssl_set_fd: func(*Ssl, i32) i32,
    ssl_get0_param: func(*Ssl) *X509_VERIFY_PARAM,
    x509_verify_param_set1_host: func(*X509_VERIFY_PARAM, *u8, u64) i32,
    ssl_ctrl: func(*Ssl, i32, i64, *void) i64,
    ssl_connect: func(*Ssl) i32,
    ssl_read: func(*Ssl, mut* void, i32) i32,
    ssl_write: func(*Ssl, *void, i32) i32,
    ssl_shutdown: func(*Ssl) i32,
}

impl OpenSSL : Zeroable {}

var openssl: OpenSSL;
var openssl_loaded: bool;

func ensure_openssl_loaded() {
    if (openssl_loaded) return;

    // Load library
    var names = [3]StringView { "libssl.so", "libssl.so.3", "libssl.so.1.1" };
    var lib_opt: ?Library;

    for (var i = 0u; i < 3u && lib_opt.is_none(); i++) {
        lib_opt = Library::open(names[i]);
    }

    // Get functions
    var lib = lib_opt.expect("failed to open OpenSSL");

    openssl = OpenSSL {
        client_method: lib.get("TLS_client_method").expect("failed to get 'TLS_client_method' from OpenSSL") as func() *Method,
        ctx_new: lib.get("SSL_CTX_new").expect("failed to get 'SSL_CTX_new' from OpenSSL") as func(*Method) *SslCtx,
        ctx_free: lib.get("SSL_CTX_free").expect("failed to get 'SSL_CTX_free' from OpenSSL") as func(*SslCtx),
        ctx_set_default_verify_paths: lib.get("SSL_CTX_set_default_verify_paths").expect("failed to get 'SSL_CTX_set_default_verify_paths' from OpenSSL") as func(*SslCtx) i32,
        ctx_set_verify: lib.get("SSL_CTX_set_verify").expect("failed to get 'SSL_CTX_set_verify' from OpenSSL") as func(*SslCtx, i32, *void),
        ssl_new: lib.get("SSL_new").expect("failed to get 'SSL_new' from OpenSSL") as func(*SslCtx) *Ssl,
        ssl_free: lib.get("SSL_free").expect("failed to get 'SSL_free' from OpenSSL") as func(*Ssl),
        ssl_set_fd: lib.get("SSL_set_fd").expect("failed to get 'SSL_set_fd' from OpenSSL") as func(*Ssl, i32) i32,
        ssl_get0_param: lib.get("SSL_get0_param").expect("failed to get 'SSL_get0_param' from OpenSSL") as func(*Ssl) *X509_VERIFY_PARAM,
        x509_verify_param_set1_host: lib.get("X509_VERIFY_PARAM_set1_host").expect("failed to get 'X509_VERIFY_PARAM_set1_host' from OpenSSL") as func(*X509_VERIFY_PARAM, *u8, u64) i32,
        ssl_ctrl: lib.get("SSL_ctrl").expect("failed to get 'SSL_ctrl'") as func(*Ssl, i32, i64, *void) i64,
        ssl_connect: lib.get("SSL_connect").expect("failed to get 'SSL_connect' from OpenSSL") as func(*Ssl) i32,
        ssl_read: lib.get("SSL_read").expect("failed to get 'SSL_read' from OpenSSL") as func(*Ssl, mut* void, i32) i32,
        ssl_write: lib.get("SSL_write").expect("failed to get 'SSL_write' from OpenSSL") as func(*Ssl, *void, i32) i32,
        ssl_shutdown: lib.get("SSL_shutdown").expect("failed to get 'SSL_shutdown' from OpenSSL") as func(*Ssl) i32,
    };

    openssl_loaded = true;
}

// TlsSocket

pub struct TlsSocket {
    fd: SocketFd,

    ctx: *SslCtx,
    ssl: *Ssl,
}

impl TlsSocket {
    pub func connect(ip: [4]u8, port: u16, hostname: StringView) ?Self {
        ensure_openssl_loaded();

        var address = sys::SocketAddress::new(sys::Domain::IP4, ip, port);
        var fd = SocketFd::connect(address)?;

        var ctx = openssl.ctx_new(openssl.client_method());
        if (ctx == null) {
            fd.close();
            return Option:[Self]::none();
        }

        openssl.ctx_set_default_verify_paths(ctx);
        openssl.ctx_set_verify(ctx, 1, null); // 1 - SSL_VERIFY_PEER

        var ssl = openssl.ssl_new(ctx);
        openssl.ssl_set_fd(ssl, fd.fd);

        var param = openssl.ssl_get0_param(ssl);
        openssl.x509_verify_param_set1_host(param, hostname.ptr, hostname.size);

        var hostname_c = to_cstring(hostname);
        openssl.ssl_ctrl(ssl, 55, 0, hostname_c);
        free(hostname_c);

        var socket = Self {
            fd: fd,
            ctx: ctx,
            ssl: ssl,
        };

        if (openssl.ssl_connect(ssl) <= 0) {
            socket.close();
            return Option:[Self]::none();
        }

        return socket;
    }

    pub func is_open(self) bool {
        return self.fd.is_open();
    }

    pub func receive(mut self, buffer: mut []u8) ?u64 {
        if (buffer.size > 2_147_483_647u) buffer = buffer.slice(0u, 2_147_483_647u);

        var result = openssl.ssl_read(self.ssl, buffer.ptr, buffer.size as i32);
        if (result < 0) return Option:[u64]::none();

        return result as u64;
    }

    pub func send(mut self, data: []u8) ?u64 {
        if (data.size > 2_147_483_647u) data = data.slice(0u, 2_147_483_647u);

        var result = openssl.ssl_write(self.ssl, data.ptr, data.size as i32);
        if (result < 0) return Option:[u64]::none();

        return result as u64;
    }

    pub func close(mut self) {
        openssl.ssl_shutdown(self.ssl);
        openssl.ssl_free(self.ssl);
        self.ssl = null;

        openssl.ctx_free(self.ctx);
        self.ctx = null;

        self.fd.close();
    }
}
