mod std::net;

import std::io::{Reader, Writer};

#[cfg(target_family = "windows")]
import std::net::windows::{SocketFd, SocketAddress, Domain, Type, Protocol};
#[cfg(target_family = "unix")]
import std::net::unix::{SocketFd, SocketAddress, Domain, Type, Protocol};

pub struct Socket {
    pub ip: [4]u8,
    pub port: u16,

    fd: SocketFd,
    open: bool,
}

impl Socket {
    /// Opens an active connection to the given IP address and port.
    pub func connect(ip: [4]u8, port: u16) ?Self {
        var address = SocketAddress::new(Domain::IP4, ip, port);

        return Self {
            ip: ip,
            port: port,
            fd: SocketFd::connect(address)?,
            open: true,
        };
    }

    /// Binds a socket to the given IP and port and starts listening for incoming connections.
    pub func listen(ip: [4]u8, port: u16) ?Self {
        var address = SocketAddress::new(Domain::IP4, ip, port);

        return Self {
            ip: ip,
            port: port,
            fd: SocketFd::listen(address)?,
            open: true,
        };
    }

    pub func is_open(self) bool {
        return self.open && self.fd.is_open();
    }

    /// Accepts the next incoming connection from a listening socket.
    /// Blocks until a connection arrives.
    pub func accept(self) ?Self {
        var address: SocketAddress;
        var address_len = sizeof(SocketAddress);

        return Self {
            ip: address.ip,
            port: address.port(),
            fd: self.fd.accept(&address, &address_len)?,
            open: true,
        };
    }

    pub func close(mut self) {
        self.fd.close();
        self.open = false;
    }
}

impl Socket : Reader {
    pub func read(mut self, buffer: mut []u8) ?u64 {
        return self.fd.receive(buffer);
    }
}

impl Socket : Writer {
    pub func write(mut self, data: []u8) ?u64 {
        return self.fd.send(data);
    }
}
