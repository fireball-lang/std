mod std;

import std::backtrace::{State, Code, create_state, full};
import std::os::{stderr, exit};
import std::c::{from_cstring};
import std::fmt::{Formatter};

#[init]
func init_panic() {
    set_panic_handler(panic_handler);
}

func panic_handler(msg: StringView) {
    var w = stderr();

    w.write("panic: ");
    w.write(msg);
    w.write("\n");

    var frame: u32;

    var state = create_state(null, 0, error_callback, null);
    full(state, 0, backtrace_callback, error_callback, &frame);

    exit(1);
}

func error_callback(_data: *void, msg: *u8, err: i32) {
    var fmt = Formatter::new(stderr());

    fmt.i64(err);
    fmt.str(": ");
    fmt.str(from_cstring(msg));
    fmt.str("\n");
}

func backtrace_callback(data: *void, pc: u64, filename_cstr: *u8, line: i32, function_cstr: *u8) Code {
    var fmt = Formatter::new(stderr());

    var frame_ptr = data as mut *u32;
    var frame = *frame_ptr;
    (*frame_ptr)++;

    var function = "";
    if (function_cstr != null) function = from_cstring(function_cstr);
    if (function == "fb$std$panic_handler" || function == "fb$core$panic") return Code::Continue;
    if (function.starts_with("fb$")) function = function.slice(3, function.size);

    fmt.str("  [");
    if (frame < 10) fmt.str(" ");
    fmt.u64(frame);
    fmt.str("] ");
    write_hex(fmt, pc);

    if (function_cstr != null) {
        fmt.str(" - ");
        fmt.str(function);

        if (filename_cstr != null) {
            fmt.str("\n      at ");
            fmt.str(from_cstring(filename_cstr));
        }

        fmt.str(":");
        fmt.i64(line);
    }
    else {
        fmt.str(" - <unknown function>");
    }

    fmt.str("\n");

    return Code::Continue;
}

func write_hex(fmt: Formatter, val: u64) {
    if (val == 0) {
        fmt.str("0x0");
        return;
    }

    fmt.str("0x");

    var buf: [16]u8;

    var i: u32 = 16;
    var temp = val;

    while (temp > 0) {
        i = i - 1;

        // Get the lowest 4 bits (values 0 through 15)
        var digit = (temp & 0xF) as u8;

        // Convert to ASCII
        if (digit < 10) {
            buf[i] = '0' + digit;
        } else {
            buf[i] = ('A' - 10u) + digit;
        }

        // Shift right by 4 bits to process the next hex digit
        temp = temp >>> 4;
    }

    fmt.str(StringView { ptr: &buf[i], size: 16 - i });
}
