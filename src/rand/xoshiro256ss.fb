mod std::rand;

import std::rand::{Rng, entropy};

/// Xoshiro256** pseudo-random number generator.
///
/// It has a period of 2^256 - 1 and
/// passes the usual statistical test suites, but it is **not** cryptographically
/// secure: do not use it for keys, tokens or other secrets.
///
/// Deterministic: given the same seed it always produces the same sequence.
/// Use `new` to seed it from the operating system when unpredictability is
/// required.
///
/// A value type: a copy carries an independent copy of the state, so a copy
/// continues the same sequence as the original.
pub struct Xoshiro256ss {
    s0: u64,
    s1: u64,
    s2: u64,
    s3: u64,
}

impl Xoshiro256ss : Rng {
    pub func next_u64(mut self) u64 {
        var result = rotl(self.s1 * 5, 7) * 9;
    	var t = self.s1 << 17;

    	self.s2 ^= self.s0;
    	self.s3 ^= self.s1;
    	self.s1 ^= self.s2;
    	self.s0 ^= self.s3;

    	self.s2 ^= t;
    	self.s3 = rotl(self.s3, 45);

    	return result;
    }

    pub func fill(mut self, dst: mut []u8) {
        var i = 0u;

        // 1. Align `dst.ptr + i` to 8 bytes by writing single bytes.
        var head = (8u - ((dst.ptr as u64) % 8u)) % 8u;
        if (head > dst.size) head = dst.size;

        if (head > 0) {
            var value = self.next_u64();

            for (var b = 0u; b < head; b++) {
                dst.ptr[i] = (value >>> (b * 8u)) as u8;
                i += 1u;
            }
        }

        // 2. `&dst.ptr[i]` is now 8-byte aligned: fill the middle with 64-bit stores.
        if (i + 8u <= dst.size) {
            var chunks = (&dst.ptr[i]) as mut *u64;
            var c = 0u;

            while (i + 8u <= dst.size) {
                chunks[c] = self.next_u64();
                c += 1u;
                i += 8u;
            }
        }

        // 3. Remaining bytes.
        if (i < dst.size) {
            var value = self.next_u64();

            for (var b = 0u; i < dst.size; b++) {
                dst.ptr[i] = (value >>> (b * 8u)) as u8;
                i += 1u;
            }
        }
    }
}

impl Xoshiro256ss {
    /// Creates a generator seeded from the operating system's entropy source.
    /// Returns `None` if the OS could not provide entropy.
    pub func new() ?Self {
        return Self::from_seed(entropy()?);
    }

    /// Creates a generator from a fixed `seed`. The seed is expanded with
    /// SplitMix64 into the four state words. The same seed always produces the
    /// same sequence.
    pub func from_seed(seed: u64) Self {
        return Self {
            s0: splitmix64(&seed),
            s1: splitmix64(&seed),
            s2: splitmix64(&seed),
            s3: splitmix64(&seed),
        };
    }
}

impl Xoshiro256ss {
    /// Returns the next 32 random bits.
    pub func next_u32(mut self) u32 {
        return self.next_u64() as u32;
    }

    /// Returns a random `bool` (`true` with probability 0.5).
    pub func next_bool(mut self) bool {
        return (self.next_u64() & 1) == 1;
    }

    /// Returns a uniformly distributed `f64` in `[0.0, 1.0)`.
    pub func next_f64(mut self) f64 {
        return ((self.next_u64() >>> 11) as f64) / 9007199254740992.0;
    }

    /// Returns a uniformly distributed value in `[low, high)`.
    /// Panics if `low >= high`.
    pub func next_u64_range(mut self, low: u64, high: u64) u64 {
        if (low >= high) panic("`low` must be less than `high`");

        var range = high - low;

        // Rejection sampling to avoid modulo bias.
        var limit = (0xFFFFFFFFFFFFFFFF / range) * range;
        var x = self.next_u64();

        while (x >= limit) {
            x = self.next_u64();
        }

        return low + (x % range);
    }

    /// Returns a uniformly distributed value in `[low, high)`.
    /// Panics if `low >= high`.
    pub func next_i64_range(mut self, low: i64, high: i64) i64 {
        if (low >= high) panic("`low` must be less than `high`");

        // Unsigned subtraction keeps the width correct even for extreme bounds.
        var range = (high as u64) - (low as u64);
        var offset = self.next_u64_range(0, range);

        return low + (offset as i64);
    }

    /// Returns a random element, or `None` if `items` is empty.
    pub func choose[T](mut self, items: []T) ?T {
        if (items.size == 0) return Option:[T]::none();

        return items[self.next_u64_range(0, items.size)];
    }

    /// Shuffles `items` in place.
    pub func shuffle[T](mut self, items: mut []T) {
        if (items.size < 2) return;

        // Fisher-Yates
        var i = items.size - 1;

        while (i > 0) {
            var j = self.next_u64_range(0, i + 1);

            var tmp = items[i];
            items[i] = items[j];
            items[j] = tmp;

            i -= 1;
        }
    }
}

func splitmix64(state: mut &u64) u64 {
    *state += 0x9E3779B97F4A7C15;

    var z = *state;
    z = (z ^ (z >>> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >>> 27)) * 0x94D049BB133111EB;

    return z ^ (z >>> 31);
}

func rotl(x: u64, k: u64) u64 {
    return (x << k) | (x >>> (64 - k));
}
