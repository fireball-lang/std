mod std::os;

#[cfg(target_family = "windows")]
import std::os::windows::{Fd};
#[cfg(target_family = "unix")]
import std::os::unix::{Fd};

import std::io::{Reader, Writer};
import std::os::{File};

/// Enum represeting standard input / output streams.
/// The values match POSIX stdio values.
pub enum StdStream {
    Input = 0,
    Output = 1,
    Error = 2,
}

var stdin_file: File;
var stdout_file: File;
var stderr_file: File;

var stdio_initialised: bool;

func ensure_stdio_initialized() {
    if (stdio_initialised) return;

    stdin_file = File::from_fd(Fd::stdin());
    stdout_file = File::from_fd(Fd::stdout());
    stderr_file = File::from_fd(Fd::stderr());

    stdio_initialised = true;
}

pub func get_std_stream(stream: StdStream) mut Reader {
    ensure_stdio_initialized();

    if (stream == StdStream::Input) return &stdin_file;
    if (stream == StdStream::Output) return &stdout_file;

    return &stderr_file;
}

pub func stdin() mut Reader {
    ensure_stdio_initialized();
    return &stdin_file;
}

pub func stdout() mut Writer {
    ensure_stdio_initialized();
    return &stdout_file;
}

pub func stderr() mut Writer {
    ensure_stdio_initialized();
    return &stderr_file;
}
