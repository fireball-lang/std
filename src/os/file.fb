mod std::os;

#[cfg(target_family = "windows")]
import std::os::windows::{Fd};
#[cfg(target_family = "unix")]
import std::os::unix::{Fd};

import std::io::{Reader, Writer};

pub enum Seek {
    Start = 0,
    Current = 1,
    End = 2,
}

pub struct File {
    fd: Fd,
    open: bool,
}

impl File {
    pub func create(path: StringView) ?Self {
        return File {
            fd: Fd::create(path)?,
            open: true,
        };
    }

    pub func open(path: StringView) ?Self {
        return File {
            fd: Fd::open(path)?,
            open: true,
        };
    }

    /// Wraps an existing `Fd`, taking ownership of it.
    /// The caller must not close the `Fd` afterwards.
    pub func from_fd(fd: Fd) Self {
        return File {
            fd: fd,
            open: true,
        };
    }

    pub func seek(mut self, mode: Seek, offset: i64) ?u64 {
        return self.fd.seek(mode, offset);
    }

    pub func size(mut self) ?u64 {
        var position = self.fd.seek(Seek::Current, 0)?;
        var size = self.fd.seek(Seek::End, 0)?;
        self.fd.seek(Seek::Start, position as i64)?;

        return size;
    }

    /// Closes the file, releasing the underlying descriptor.
    /// Panics if the file is already closed.
    pub func close(mut self) {
        if (!self.open) panic("tried to close an already closed file");

        self.fd.close();
        self.open = false;
    }
}

impl File : Reader {
    pub func read(mut self, buffer: mut []u8) ?u64 {
        return self.fd.read(buffer);
    }
}

impl File : Writer {
    pub func write(mut self, data: []u8) ?u64 {
        return self.fd.write(data);
    }
}
