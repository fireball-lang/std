#[cfg(target_family = "windows")]

mod std::os::windows;

import std::os::{Stdio, ProcessInfo, Process, ExitStatus};
import std::c::{to_cstring, malloc, free};
import std::os::windows::{Fd};
import std::{String};
import std::sys;

pub func spawn(info: ProcessInfo) ?Process {
    // Allocate application name
    var app_name = to_cstring(info.program);

    // Allocate command line
    var cmd_line = String::with_capacity(64);

    write_arg(&cmd_line, info.program);

    for (var i = 0u; i < info.args.size(); i++) {
        var arg = info.args[i];
        write_arg(&cmd_line, arg);
    }

    cmd_line.write("\x00");

    // Allocate envrionment
    var environment: String;
    var env_ptr: *u8;

    if (info.env.size() > 0) {
        environment = String::with_capacity(256);

        for (var i = 0u; i < info.env.size(); i++) {
            var item = info.env.get_at(i);

            environment.write(item.key);
            environment.write("=");
            environment.write(item.value);
            environment.write("\x00");
        }

        environment.write("\x00");
        env_ptr = environment.as_bytes().ptr;
    }

    // Allocate cwd
    var cwd: *u8;

    if (info.cwd != "") {
        cwd = to_cstring(info.cwd);
    }

    // Create startup info
    var start_info = sys::StartupInfo {
        cb: sizeof(sys::StartupInfo),
        flags: 0x00000100, // STARTF_USESTDHANDLES
    };

    var inherit_security = sys::SecurityAttributes {
        length: sizeof(sys::SecurityAttributes),
        inherit_handle: 1,
    };

    var stdin_read_pipe = sys::Handle::invalid();
    var stdin_write_pipe = sys::Handle::invalid();

    if (info.stdin == Stdio::Null) {
        start_info.std_input = sys::CreateFileA("NUL".ptr, sys::Access::Read, sys::Share::Read, &inherit_security, sys::Disposition::OpenExisting, sys::Flags::Normal, null);
    }
    else if (info.stdin == Stdio::Pipe) {
        sys::CreatePipe(&stdin_read_pipe, &stdin_write_pipe, &inherit_security, 0);

        start_info.std_input = stdin_read_pipe;
        sys::SetHandleInformation(stdin_write_pipe, sys::HandleFlags::Inherit, 0 as sys::HandleFlags);
    }
    else {
        start_info.std_input = Fd::stdin().handle;
    }

    var stdout_read_pipe = sys::Handle::invalid();
    var stdout_write_pipe = sys::Handle::invalid();

    if (info.stdout == Stdio::Null) {
        start_info.std_output = sys::CreateFileA("NUL".ptr, sys::Access::Write, sys::Share::Read | sys::Share::Write, &inherit_security, sys::Disposition::OpenExisting, sys::Flags::Normal, null);
    }
    else if (info.stdout == Stdio::Pipe) {
        sys::CreatePipe(&stdout_read_pipe, &stdout_write_pipe, &inherit_security, 0);

        start_info.std_output = stdout_write_pipe;
        sys::SetHandleInformation(stdout_read_pipe, sys::HandleFlags::Inherit, 0 as sys::HandleFlags);
    }
    else {
        start_info.std_output = Fd::stdout().handle;
    }

    var stderr_read_pipe = sys::Handle::invalid();
    var stderr_write_pipe = sys::Handle::invalid();

    if (info.stderr == Stdio::Null) {
        start_info.std_error = sys::CreateFileA("NUL".ptr, sys::Access::Write, sys::Share::Read | sys::Share::Write, &inherit_security, sys::Disposition::OpenExisting, sys::Flags::Normal, null);
    }
    else if (info.stderr == Stdio::Pipe) {
        sys::CreatePipe(&stderr_read_pipe, &stderr_write_pipe, &inherit_security, 0);

        start_info.std_error = stderr_write_pipe;
        sys::SetHandleInformation(stderr_read_pipe, sys::HandleFlags::Inherit, 0 as sys::HandleFlags);
    }
    else {
        start_info.std_error = Fd::stderr().handle;
    }

    // Create process
    var result: ?Process;
    var proc_info: sys::ProcessInformation;

    if (sys::CreateProcessA(app_name, cmd_line.as_bytes().ptr, null, null, 1, 0, env_ptr, cwd, &start_info, &proc_info) != 0) {
        sys::CloseHandle(&proc_info.thread);

        var process = Process {
            id: proc_info.process.raw as u64,
            stdin: Fd { handle: stdin_write_pipe },
            stdout: Fd { handle: stdout_read_pipe },
            stderr: Fd { handle: stderr_read_pipe },
        };

        result = process;
    }
    else {
        if (info.stdin == Stdio::Pipe) sys::CloseHandle(&stdin_write_pipe);
        if (info.stdout == Stdio::Pipe) sys::CloseHandle(&stdout_read_pipe);
        if (info.stderr == Stdio::Pipe) sys::CloseHandle(&stderr_read_pipe);
    }

    if (info.stdin == Stdio::Null || info.stdin == Stdio::Pipe) sys::CloseHandle(&start_info.std_input);
    if (info.stdout == Stdio::Null || info.stdout == Stdio::Pipe) sys::CloseHandle(&start_info.std_output);
    if (info.stderr == Stdio::Null || info.stderr == Stdio::Pipe) sys::CloseHandle(&start_info.std_error);

    // Free cwd
    if (cwd != null) {
        free(cwd);
    }

    // Free environment
    if (info.env.size() > 0) {
        environment.free();
    }

    // Free command line
    cmd_line.free();

    // Free application name
    free(app_name);

    return result;
}

func write_arg(str: mut &String, arg: StringView) {
    if (str.size() > 0) {
        str.write(" ");
    }

    // Empty
    if (arg == "") {
        str.write("\"\"");
        return;
    }

    // Unescaped
    if (!arg.contains(" ") && !arg.contains("\t") && !arg.contains("\"")) {
        str.write(arg);
        return;
    }

    // Escaped
    str.write("\"");

    var backslashes = 0u;

    for (var i = 0u; i < arg.size; i++) {
        var ch = arg[i];

        if (ch == '\\') {
            backslashes += 1;
        }
        else {
            if (ch == '"') {
                for (var j = 0u; j <= backslashes; j++) {
                    str.write("\\");
                }
            }

            backslashes = 0;
        }

        str.write(Slice:[u8] { ptr: &ch, size: 1 });
    }

    for (var j = 0u; j < backslashes; j++) {
        str.write("\\");
    }

    str.write("\"");
}

pub func wait(pid: u64) ?ExitStatus {
    var handle = sys::Handle { raw: pid as *void };

    // Wait for process to exit
    {
        var result = sys::WaitForSingleObject(handle, 0xFFFFFFFF);
        if (result == 0xFFFFFFFF) return Option:[ExitStatus]::none();
    }

    // Get exit code
    var exit_code: u32;
    var result = sys::GetExitCodeProcess(handle, &exit_code);

    // Close process handle
    sys::CloseHandle(&handle);

    // Return
    if (result == 0) return Option:[ExitStatus]::none();
    return ExitStatus { raw: exit_code };
}
