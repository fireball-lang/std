#[cfg(target_family = "windows")]

mod std::os::windows;

import std::c::{to_cstring, free};
import std::sys;

pub struct Library {
    module: *void,
}

impl Library {
    pub func open(name: StringView) ?Self {
        var c_name = to_cstring(name);
        var module = sys::LoadLibraryA(c_name);
        free(c_name);

        if (module == null) {
            return Option:[Self]::none();
        }

        return Self {
            module: module,
        };
    }

    pub func get(self, name: StringView) ?&void {
        var c_name = to_cstring(name);
        var symbol = sys::GetProcAddress(self.module, c_name);
        free(c_name);

        if (symbol == null) {
            return Option:[&void]::none();
        }

        return symbol as &void;
    }

    pub func close(mut self) {
        if (self.module == null) panic("tried to close an already closed Library");

        sys::FreeLibrary(self.module);
        self.module = null;
    }
}
