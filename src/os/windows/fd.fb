#[cfg(target_family = "windows")]

mod std::os::windows;

import std::os::{Seek, FileKind, FileInfo};
import std::c::{to_cstring, free};
import std::io::{Reader, Writer};
import std::os::windows::api;

pub struct Fd {
    handle: api::Handle,
}

impl Fd {
    pub func create(path: StringView) ?Fd {
        var path_c = to_cstring(path);
        var handle = api::CreateFileA(path_c, api::Access::Write, api::Share::Exclusive, null, api::Disposition::CreateAlways, api::Flags::Normal, null);
        free(path_c);

        if (!handle.valid()) return Option:[Fd]::none();
        return Fd { handle: handle };
    }

    pub func open(path: StringView) ?Fd {
        var path_c = to_cstring(path);
        var handle = api::CreateFileA(path_c, api::Access::Read, api::Share::Read, null, api::Disposition::OpenExisting, api::Flags::Normal, null);
        free(path_c);

        if (!handle.valid()) return Option:[Fd]::none();
        return Fd { handle: handle };
    }

    pub func stdin() Fd {
        return Fd { handle: api::GetStdHandle(-10 as u32) };
    }

    pub func stdout() Fd {
        return Fd { handle: api::GetStdHandle(-11 as u32) };
    }

    pub func stderr() Fd {
        return Fd { handle: api::GetStdHandle(-12 as u32) };
    }

    pub func invalid() Fd {
        return Fd { handle: api::Handle::invalid() };
    }

    pub func close(mut self) {
        if (!self.handle.valid()) return;

        api::CloseHandle(&self.handle);
    }

    pub func seek(mut self, mode: Seek, offset: i64) ?u64 {
        var new_pos: i64 = 0;

        if (api::SetFilePointerEx(self.handle, offset, &new_pos, mode as u32) == 0) {
            return Option:[u64]::none();
        }

        return new_pos as u64;
    }
}

impl Fd : Reader {
    pub func read(mut self, buffer: mut []u8) ?u64 {
        if (buffer.size > 4_294_967_295u) buffer = buffer.slice(0u, 4_294_967_295u);

        var bytes_read: u32 = 0u;

        if (api::ReadFile(self.handle, buffer.ptr, buffer.size as u32, &bytes_read, null) == 0) {
            return Option:[u64]::none();
        }

        return bytes_read as u64;
    }
}

impl Fd : Writer {
    pub func write(mut self, data: []u8) ?u64 {
        if (data.size > 4_294_967_295u) data = data.slice(0u, 4_294_967_295u);

        var bytes_written: u32 = 0u;

        if (api::WriteFile(self.handle, data.ptr, data.size as u32, &bytes_written, null) == 0) {
            return Option:[u64]::none();
        }

        return bytes_written as u64;
    }
}

pub func stat(path: *u8) ?FileInfo {
    // Call native API
    var data: api::FileAttributeData;
    var result = api::GetFileAttributesExA(path, 0, &data);

    if (result == 0) return Option:[FileInfo]::none();

    // Create FileInfo
    return get_file_info(data);
}

pub func get_file_info(data: api::FileAttributeData) FileInfo {
    var kind = FileKind::File;

    if ((data.file_attributes & 0x00000010) != 0) kind = FileKind::Directory;
    else if ((data.file_attributes & 0x00000400) != 0) kind = FileKind::Symlink;

    return FileInfo {
        kind: kind,
        size: (data.file_size_high as u64 << 32) | (data.file_size_low as u64),
    };
}
