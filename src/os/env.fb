mod std::os;

import std::c::{to_cstring, from_cstring, free};

#[extern]
func getenv(name: *u8) *u8;

/// Returns the value of requested environment variable or `None` if not found.
pub func get_env(key: StringView) ?StringView {
    var name = to_cstring(key);
    var value = getenv(name);
    free(name);

    if (value == null) return Option:[StringView]::none();
    return from_cstring(value);
}
