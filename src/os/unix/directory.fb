#[cfg(target_family = "unix")]

mod std::os::unix;

import std::c::{to_cstring, malloc, free};
import std::os::{FileKind, FileInfo};
import std::os::unix::{stat};
import std::sys;

pub func create_dir(path: StringView) ?bool {
    var c_path = to_cstring(path);
    var result = sys::mkdir(c_path, 511);
    free(c_path);

    if (result == -1) return Option:[bool]::none();
    return true;
}

pub func delete_dir(path: StringView) ?bool {
    var c_path = to_cstring(path);
    var result = sys::rmdir(c_path);
    free(c_path);

    if (result == -1) return Option:[bool]::none();
    return true;
}

// Listing

pub struct DirEntryInfo {
    empty: bool,
    info: FileInfo,
}

impl DirEntryInfo {
    pub func get(mut self, iter: &DirIterator, name: StringView) ?FileInfo {
        if (self.empty) {
            self.info = iter.stat(name)?;
            self.empty = false;
        }

        return self.info;
    }
}

#[cfg(target_os = "linux")]
pub struct DirIterator {
    path: StringView,
    dir: i32,

    buffer: mut *u8,
    index: u32,
    size: u32,

    #[cfg(target_os = "macos")]
    base: i64,
}

pub func list_dir(path: StringView) ?DirIterator {
    var c_path = to_cstring(path);
    var dir = sys::openat(sys::at_fdcwd(), c_path, sys::FileFlags::ReadOnly | sys::FileFlags::Directory, 0);

    if (dir < 0) {
        free(c_path);
        return Option:[DirIterator]::none();
    }

    return DirIterator {
        path: StringView { ptr: c_path, size: path.size },
        dir: dir,
        buffer: malloc(1024) as mut *u8,
    };
}

impl DirIterator {
    pub func next(mut self, kind: mut &FileKind, info: mut &DirEntryInfo) StringView {
        if (self.dir < 0) return "";

        for (;;) {
            // Read more entries if necessary
            if (self.index >= self.size) {
                if (!self.read()) {
                    // EOF
                    free(self.path.ptr);
                    sys::close(self.dir);
                    free(self.buffer);

                    self.dir = -1;
                    return "";
                }
            }

            var entry = &self.buffer[self.index] as *sys::Dirent64;
            self.index += entry.reclen;

            // Skip over '.' and '..'
            var name = entry.name();
            if (name == "." || name == "..") continue;

            // Get FileKind with fallback to `stat()`
            info.empty = true;

            if (entry.type_ == 0) {
                var info_opt = self.stat(name);

                if (info_opt.is_some()) {
                    info.empty = false;
                    info.info = info_opt.unwrap();

                    *kind = info.info.kind;
                }
            }
            else if (entry.type_ == 8) {
                *kind = FileKind::File;
            }
            else if (entry.type_ == 4) {
                *kind = FileKind::Directory;
            }
            else if (entry.type_ == 10) {
                *kind = FileKind::Symlink;
            }
            else {
                *kind = FileKind::Other;
            }

            // Return
            return name;
        }

        // unreachable
        return "";
    }

    func stat(self, name: StringView) ?FileInfo {
        var slash = 0u;
        if (!self.path.ends_with("/")) slash = 1;

        var path = malloc(self.path.size + slash + name.size + 1) as mut *u8;

        memcpy(&path[0], self.path.ptr, self.path.size);
        if (slash != 0) path[self.path.size] = '/';
        memcpy(&path[self.path.size + slash], name.ptr, name.size);
        path[self.path.size + slash + name.size] = 0;

        var result = stat(path);
        free(path);

        return result;
    }


    #[cfg(target_os = "linux")]
    func read(mut self) bool {
        var result = sys::getdents64(self.dir, self.buffer, 1024);
        if (result <= 0) return false;

        self.index = 0;
        self.size = result as u32;

        return true;
    }

    #[cfg(target_os = "macos")]
    func read(mut self) bool {
        var result = sys::getdirentries(self.dir, self.buffer, 4096, &self.base);
        if (result <= 0) return false;

        self.index = 0;
        self.size = result as u32;

        return true;
    }
}
