#[cfg(target_family = "unix")]

mod std::os::unix::api;

// Enums

#[cfg(target_os = "linux")]
pub enum FileFlags : i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    Create = 64,
    Truncate = 512,
    CloseOnExec = 524288,
}

#[cfg(target_os = "macos")]
pub enum FileFlags : i32 {
    ReadOnly = 0,
    WriteOnly = 1,
    Create = 512,
    Truncate = 1024,
    CloseOnExec = 16777216,
}

impl FileFlags : BitOr[FileFlags] {
    type Result = FileFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

#[cfg(target_os = "linux")]
pub enum LibFlags : i32 {
    Lazy = 0x00001,
    Now = 0x00002,
    NoLoad = 0x00004,

    Global = 0x00100,
    Local = 0x0000,

    NoDelete = 0x01000,
}
#[cfg(target_os = "macos")]
pub enum LibFlags : i32 {
    Lazy = 0x00001,
    Now = 0x00002,
    NoLoad = 0x00010,

    Global = 0x00008,
    Local = 0x0004,

    NoDelete = 0x00080,
}

impl LibFlags : BitOr[LibFlags] {
    type Result = LibFlags;

    pub func bit_or(self, rhs: Self) Self {
        return (*self as i32 | rhs as i32) as Self;
    }
}

// Structs

#[repr(C), cfg(target_os = "linux")]
pub struct Dirent {
    pub ino: u64,
    pub off: i64,
    pub reclen: u16,
    pub type_: u8,
    pub name: [256]u8,
}
#[repr(C), cfg(target_os = "macos")]
pub struct Dirent {
    pub ino: u64,
    pub off: u64,
    pub reclen: u16,
    pub namlen: u16,
    pub type_: u8,
    pub name: [1024]u8,
}

#[repr(C)]
pub struct Timespec {
    pub sec: i64,
    pub nsec: i64,
}

#[repr(C), cfg(target_os = "linux")]
pub struct Stat {
    pub dev: u64,
    pub ino: u64,
    pub nlink: u64,
    pub mode: u32,
    pub uid: u32,
    pub gid: u32,
    pub rdev: u64,
    pub size: u64,
    pub blksize: u64,
    pub blocks: u64,

    pub atim: Timespec,
    pub mtim: Timespec,
    pub ctim: Timespec,

    _pad: [3]u64,
}
#[repr(C), cfg(target_os = "macos")]
pub struct Stat {
    pub dev: i32,
    pub mode: u16,
    pub nlink: u16,
    pub ino: u64,
    pub uid: u32,
    pub gid: u32,
    pub rdev: i32,

    pub atim: Timespec,
    pub mtim: Timespec,
    pub ctim: Timespec,
    pub birthtim: Timespec,

    pub size: u64,
    pub blocks: u64,
    pub blksize: u32,
    pub flags: u32,
    pub gen: u32,

    pub lspare: i32,
    pub qspare: [2]i64,
}

// Functions

#[extern]
pub func getcwd(buffer: mut *u8, size: u64) *u8;

#[extern]
pub func mkdir(path: *u8, mode: u32) i32;

#[extern]
pub func rmdir(path: *u8) i32;

#[extern, cfg(target_os = "linux")]
pub func opendir(path: *u8) *void;
#[extern, link_name("opendir$INODE64"), cfg(target_os = "macos")]
pub func opendir(path: *u8) *void;

#[extern, cfg(target_os = "linux")]
pub func readdir(dir: *void) *Dirent;
#[extern, link_name("readdir$INODE64"), cfg(target_os = "macos")]
pub func readdir(dir: *void) *Dirent;

#[extern]
pub func closedir(dir: *void) i32;

#[extern]
pub func openat(fd: i32, path: *u8, flags: FileFlags, mode: i32) i32;

#[extern]
pub func close(fd: i32) i32;

#[extern]
pub func lseek(fd: i32, offset: i64, whence: i32) i64;

#[extern]
pub func read(fd: i32, buffer: mut* void, size: u64) i64;

#[extern]
pub func write(fd: i32, data: *void, size: u64) i64;

#[extern, cfg(target_os = "linux")]
pub func fstatat(fd: i32, path: *u8, stat: mut *Stat, flags: i32) i32;
#[extern, link_name("fstatat$INODE64"), cfg(target_os = "macos")]
pub func fstatat(fd: i32, path: *u8, stat: mut *Stat, flags: i32) i32;

#[extern]
pub func dlopen(name: *u8, flags: LibFlags) *void;

#[extern]
pub func dlsym(handle: *void, name: *u8) *void;

#[extern]
pub func dlclose(handle: *void) i32;

#[extern]
pub func open(path: *u8, flags: FileFlags) i32;

#[extern]
pub func fcntl(fd: i32, cmd: i32, arg: i32) i32;

#[extern]
pub func pipe(fds: mut *i32) i32;

#[extern]
pub func dup2(oldfd: i32, newfd: i32) i32;

#[extern]
pub func fork() i32;

#[extern]
pub func chdir(path: *u8) i32;

#[extern]
pub func execve(file: *u8, argv: **u8, envp: **u8) i32;

#[extern]
pub func waitpid(pid: i32, status: mut *i32, options: i32) i32;

#[cfg(target_os = "linux")]
pub func at_fdcwd() i32 {
    return -100;
}

#[cfg(target_os = "macos")]
pub func at_fdcwd() i32 {
    return -2;
}
