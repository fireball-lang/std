#[cfg(target_family = "unix")]

mod std::os::unix;

import std::c::{to_cstring, free};
import std::sys;

pub struct Library {
    handle: *void,
}

impl Library {
    pub func open(name: StringView) ?Self {
        var c_name = to_cstring(name);
        var handle = sys::dlopen(c_name, sys::LibFlags::Lazy | sys::LibFlags::Local);
        free(c_name);

        if (handle == null) {
            return Option:[Self]::none();
        }

        return Self {
            handle: handle,
        };
    }

    pub func get(self, name: StringView) ?&void {
        var c_name = to_cstring(name);
        var symbol = sys::dlsym(self.handle, c_name);
        free(c_name);

        if (symbol == null) {
            return Option:[&void]::none();
        }

        return symbol as &void;
    }

    pub func close(mut self) {
        if (self.handle == null) panic("tried to close an already closed Library");

        sys::dlclose(self.handle);
        self.handle = null;
    }
}
