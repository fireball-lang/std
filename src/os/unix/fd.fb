#[cfg(target_family = "unix")]

mod std::os::unix;

import std::os::{Seek, FileKind, FileInfo};
import std::c::{to_cstring, free};
import std::io::{Reader, Writer};
import std::sys;

pub struct Fd {
    handle: i32,
}

impl Fd {
    pub func create(path: StringView) ?Fd {
        var path_c = to_cstring(path);
        var handle = sys::openat(sys::at_fdcwd(), path_c, sys::FileFlags::Create | sys::FileFlags::Truncate | sys::FileFlags::WriteOnly | sys::FileFlags::CloseOnExec, 438);
        free(path_c);

        if (handle < 0) return Option:[Fd]::none();
        return Fd { handle: handle };
    }

    pub func open(path: StringView) ?Fd {
        var path_c = to_cstring(path);
        var handle = sys::openat(sys::at_fdcwd(), path_c, sys::FileFlags::ReadOnly | sys::FileFlags::CloseOnExec, 0);
        free(path_c);

        if (handle < 0) return Option:[Fd]::none();
        return Fd { handle: handle };
    }

    pub func stdin() Fd {
        return Fd { handle: 0 };
    }

    pub func stdout() Fd {
        return Fd { handle: 1 };
    }

    pub func stderr() Fd {
        return Fd { handle: 2 };
    }

    pub func invalid() Fd {
        return Fd { handle: -1 };
    }

    pub func close(mut self) {
        if (self.handle == -1) return;

        sys::close(self.handle);
        self.handle = -1;
    }

    pub func seek(mut self, mode: Seek, offset: i64) ?u64 {
        var position = sys::lseek(self.handle, offset, mode as i32);
        if (position < 0) return Option:[u64]::none();

        return position as u64;
    }
}

impl Fd : Reader {
    pub func read(mut self, buffer: mut []u8) ?u64 {
        var read = sys::read(self.handle, buffer.ptr, buffer.size);
        if (read < 0) return Option:[u64]::none();

        return read as u64;
    }
}

impl Fd : Writer {
    pub func write(mut self, data: []u8) ?u64 {
        var written = sys::write(self.handle, data.ptr, data.size);
        if (written < 0) return Option:[u64]::none();

        return written as u64;
    }
}

pub func stat(path: *u8) ?FileInfo {
    // Call native API
    var stat: sys::Stat;
    var result = sys::fstatat(sys::at_fdcwd(), path, &stat, 0);

    if (result == -1) return Option:[FileInfo]::none();

    // Create FileInfo
    var mode = stat.mode & 0x0000F000;
    var kind = FileKind::Other;

    if (mode == 0x00008000) kind = FileKind::File;
    else if (mode == 0x00004000) kind = FileKind::Directory;
    else if (mode == 0x0000A000) kind = FileKind::Symlink;

    return FileInfo {
        kind: kind,
        size: stat.size,
    };
}
