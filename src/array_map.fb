mod std;

import std::json::{Serialize, Serializer, Deserialize, Deserializer, TokenKind};
import std::{ArrayList, String};

pub struct Item[K, V] {
    pub key: K,
    pub value: V,
}

pub struct ArrayMap[K: Eq[K], V] {
    items: ArrayList[Item[K, V]],
}

impl[K: Eq[K], V] ArrayMap[K, V] {
    func find(self, key: K) mut* V {
        for (var i = 0u; i < self.items.size(); i++) {
            var item = self.items.get_ptr(i);

            if (item.key == key) {
                return &item.value;
            }
        }

        return null;
    }

    pub func insert(mut self, key: K, value: V) {
        var ptr = self.find(key);

        if (ptr != null) {
            *ptr = value;
            return;
        }

        self.items.add(Item:[K, V] {
            key: key,
            value: value,
        });
    }

    pub func try_get(self, key: K, value: mut& V) bool {
        for (var i = 0u; i < self.items.size(); i++) {
            var item = self.items.get_ptr(i);

            if (item.key == key) {
                *value = item.value;
                return true;
            }
        }

        return false;
    }

    pub func contains(self, key: K) bool {
        for (var i = 0u; i < self.items.size(); i++) {
            if (self.items[i].key == key) {
                return true;
            }
        }

        return false;
    }

    /// Removes and returns the value for `key`.
    /// If `key` is absent, returns `None`.
    pub func remove(mut self, key: K) ?V {
        for (var i = 0u; i < self.items.size(); i++) {
            var item = self.items.get_ptr(i);

            if (item.key == key) {
                var value = item.value;
                self.items.remove(i);
                return value;
            }
        }

        return Option:[V]::none();
    }

    pub func size(self) u64 {
        return self.items.size();
    }

    pub func get_at(self, index: u64) Item[K, V] {
        return self.items[index];
    }

    pub func free(mut self) {
        self.items.free();
    }
}

impl[K: Eq[K], V] ArrayMap[K, V] : Index[K] {
    type Result = V;

    /// Looks up `key`.
    /// Panics if `key` is not present in the map.
    pub func index(self, i: K) V {
        var ptr = self.find(i);
        if (ptr == null) panic("ArrayMap::[] - value not found");

        return *ptr;
    }
}

impl[K: Eq[K] + ImplicitAs[StringView], V] ArrayMap[K, V] : Serialize {
    pub func serialize(self, se: mut& Serializer) {
        se.object_start();

        for (var i = 0u; i < self.size(); i++) {
            var item = self.items[i];

            se.property(item.key);
            se.serialize(&item.value, typeof(V));
        }

        se.object_end();
    }
}

impl[V: Zeroable] ArrayMap[String, V] : Deserialize {
    pub func deserialize(mut self, de: mut& Deserializer) ?bool {
        de.object_start()?;

        for (;;) {
            var kind = de.peek()?.kind;
            if (kind == TokenKind::EOF || kind == TokenKind::ObjectEnd) break;

            var property = de.property()?;

            var key = String::with_capacity(property.text.size);
            key.write(property.text);

            var value: V;
            de.deserialize(&value, typeof(V))?;

            self.insert(key, value);
        }

        de.object_end()?;
        return true;
    }
}
